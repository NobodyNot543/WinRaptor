<Window x:Class="WinPulse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WinPulse"
        Title="WinRaptor Optimizer" Icon="pack://application:,,,/WinRaptor.ico" Width="1260" Height="860" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Window.Resources>
        <LinearGradientBrush x:Key="SkelBrush" StartPoint="0,0" EndPoint="1,0">
            <LinearGradientBrush.RelativeTransform><TranslateTransform X="-1"/></LinearGradientBrush.RelativeTransform>
            <GradientStop Color="#171C27" Offset="0"/>
            <GradientStop Color="#171C27" Offset="0.3"/>
            <GradientStop Color="#252D3D" Offset="0.5"/>
            <GradientStop Color="#171C27" Offset="0.7"/>
            <GradientStop Color="#171C27" Offset="1"/>
        </LinearGradientBrush>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="Frame">
        <!-- Resplandor de fondo -->
        <Ellipse Width="700" Height="500" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-260,-200,0" IsHitTestVisible="False" Opacity="0.22">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#7C3AED" Offset="0"/>
                    <GradientStop Color="#007C3AED" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="620" Height="460" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="120,0,0,-300" IsHitTestVisible="False" Opacity="0.12">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#06B6D4" Offset="0"/>
                    <GradientStop Color="#0006B6D4" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Grid x:Name="Root">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="262"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ============ Barra lateral ============ -->
            <Border x:Name="SideBar" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#11141C" Offset="0"/>
                        <GradientStop Color="#0C0F15" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <DockPanel Margin="14,14,14,14">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,6,0,10">
                        <Image Source="pack://application:,,,/mark-bold.png" Width="50" Height="50" Margin="-4,0,0,0"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="WinRaptor" FontFamily="{StaticResource Display}" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="OPTIMIZER" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Muted}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Usuario -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <Border x:Name="UserCard" CornerRadius="14" Padding="12,11" BorderThickness="1" BorderBrush="#2B2850">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1D1838" Offset="0"/>
                                    <GradientStop Color="#121722" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <DockPanel>
                                <Grid Width="44" Height="44" DockPanel.Dock="Left">
                                    <Ellipse Margin="-5" IsHitTestVisible="False">
                                        <Ellipse.Fill>
                                            <RadialGradientBrush>
                                                <GradientStop Color="#558B5CF6" Offset="0.6"/>
                                                <GradientStop Color="#008B5CF6" Offset="1"/>
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <Ellipse Stroke="{StaticResource AccentGrad}" StrokeThickness="2"/>
                                    <Ellipse x:Name="AvatarCircle" Margin="3.5" Fill="{StaticResource AccentGrad}"/>
                                    <TextBlock x:Name="AvatarInitials" FontFamily="{StaticResource Display}" FontWeight="Bold" FontSize="15" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Ellipse Width="12" Height="12" Fill="#34D399" Stroke="#161A2A" StrokeThickness="2.5"
                                             HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-1,-1" ToolTip="Sesión iniciada"/>
                                </Grid>
                                <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="UserNameText" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Border Background="#2A2350" CornerRadius="5" Padding="6,1" VerticalAlignment="Center">
                                            <TextBlock Text="ADMIN" FontSize="9" FontWeight="Bold" Foreground="#C4B5FD"/>
                                        </Border>
                                        <Border x:Name="ProfileChip" CornerRadius="5" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center" Background="#1A1F2A" Cursor="Hand"
                                                MouseLeftButtonUp="ProfileChip_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse x:Name="ProfileDot" Width="6" Height="6" Fill="#64748B" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="ProfileText" Text="…" FontSize="9.5" FontWeight="Bold" Foreground="#94A3B8" Margin="5,0,0,0"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="96"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <TextBlock x:Name="VersionText" Foreground="#4B5568" FontSize="10.5" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>

                    <ListBox x:Name="NavList" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource NavItem}" SelectionChanged="Nav_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.Template>
                            <!-- Sin el fondo gris que WPF pone al ListBox cuando está deshabilitado -->
                            <ControlTemplate TargetType="ListBox">
                                <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto" CanContentScroll="False">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </ControlTemplate>
                        </ListBox.Template>
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock x:Name="H" Text="{Binding Name}" Foreground="#4B5568" FontSize="10" FontWeight="Bold" Margin="12,12,0,5"/>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Name}" Value="">
                                                <Setter TargetName="H" Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="IconBox" Width="26" Height="26" CornerRadius="8" Background="#00000000">
                                        <TextBlock x:Name="Glyph" Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="13.5"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" Margin="11,0,0,0" TextTrimming="CharacterEllipsis"/>
                                    <Border x:Name="CountBox" Grid.Column="2" Visibility="{Binding CountVisibility}" Background="#171C27" CornerRadius="7" Padding="7,1" VerticalAlignment="Center">
                                        <TextBlock x:Name="CountText" Text="{Binding Count}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
                                    </Border>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <Setter TargetName="IconBox" Property="Background" Value="#241F3D"/>
                                        <Setter TargetName="Glyph" Property="Foreground" Value="#C4B5FD"/>
                                        <Setter TargetName="CountText" Property="Foreground" Value="#94A3B8"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ============ Zona principal ============ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Barra de título -->
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource Chrome}" Content="&#xE921;" Click="Min_Click" ToolTip="Minimizar"/>
                    <Button Style="{StaticResource Chrome}" x:Name="MaxButton" Content="&#xE922;" Click="Max_Click" ToolTip="Maximizar"/>
                    <Button Style="{StaticResource ChromeClose}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Cerrar"/>
                </StackPanel>

                <!-- Cabecera -->
                <Grid Grid.Row="1" Margin="32,0,32,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="GameChip" Click="GameChip_Click" Visibility="Collapsed" Margin="16,0,0,0" Padding="14,9" VerticalAlignment="Center"
                                Background="#0F2E24" BorderBrush="#1F5C45" ToolTip="El modo juego está activo: pulsa para terminarlo y restaurar">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource Icons}" Foreground="#34D399" VerticalAlignment="Center"/>
                                <TextBlock Text="Modo juego activo" Foreground="#34D399" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="RebootChip" Click="RebootChip_Click" Visibility="Collapsed" Margin="16,0,0,0" Padding="14,9"
                            VerticalAlignment="Center" Background="#33260B" BorderBrush="#6B5216" ToolTip="Hay cambios que no harán efecto hasta que reinicies Windows">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource Icons}" Foreground="#FBBF24" VerticalAlignment="Center"/>
                            <TextBlock Text="Reinicio pendiente" Foreground="#FBBF24" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                    </StackPanel>
                    <StackPanel x:Name="HeaderStack" VerticalAlignment="Center">
                        <TextBlock x:Name="SectionTitle" FontFamily="{StaticResource Display}" FontSize="28" FontWeight="Bold" Text="Inicio"/>
                        <TextBlock x:Name="SectionHint" Foreground="{StaticResource Sub}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Grid Grid.Column="2" Width="300" Height="42" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBox x:Name="SearchBox" Style="{StaticResource Search}" TextChanged="Search_TextChanged"/>
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Muted}"
                                   Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <TextBlock x:Name="SearchHint" Text="Buscar ajuste…" Foreground="{StaticResource Muted}"
                                   Margin="39,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                </Grid>

                <!-- ===== Inicio ===== -->
                <ScrollViewer x:Name="HomePanel" Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="32,0,26,20">
                    <StackPanel x:Name="HomeStack">
                        <!-- Hero -->
                        <Border CornerRadius="18" Padding="30,26" Margin="0,0,0,16" BorderThickness="1" BorderBrush="#352F66" ClipToBounds="True">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#251B4D" Offset="0"/>
                                    <GradientStop Color="#141A2E" Offset="0.55"/>
                                    <GradientStop Color="#0A2E3A" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- Anillo de puntuación -->
                                <Grid Width="120" Height="120">
                                    <Ellipse Margin="-10" IsHitTestVisible="False">
                                        <Ellipse.Fill>
                                            <RadialGradientBrush>
                                                <GradientStop Color="#338B5CF6" Offset="0.55"/>
                                                <GradientStop Color="#008B5CF6" Offset="1"/>
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <Ellipse Stroke="#262B45" StrokeThickness="10"/>
                                    <Ellipse Margin="13" Stroke="#1F2440" StrokeThickness="1" StrokeDashArray="1 5"/>
                                    <Path x:Name="ScoreArc" Stroke="{StaticResource AccentGrad}" StrokeThickness="10" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                        <Path.Effect><DropShadowEffect Color="#8B5CF6" BlurRadius="16" ShadowDepth="0" Opacity="0.7"/></Path.Effect>
                                    </Path>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock x:Name="HeroScore" Text="0%" FontFamily="{StaticResource Display}" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="optimizado" Foreground="#A5B4FC" FontSize="11" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="28,0,20,0" VerticalAlignment="Center">
                                    <TextBlock Text="ESTADO DEL EQUIPO" FontSize="11" FontWeight="Bold" Foreground="#A5B4FC"/>
                                    <TextBlock x:Name="HeroTitle" FontFamily="{StaticResource Display}" FontSize="22" FontWeight="Bold" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="AppliedSummary" Foreground="#CBD5E1" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Foreground="#8892B0" Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                                               Text="Cada cambio guarda el valor original: todo se puede deshacer."/>
                                    <Border x:Name="HeroProfile" HorizontalAlignment="Left" CornerRadius="9" Padding="10,5" Margin="0,12,0,0" BorderThickness="1" Cursor="Hand"
                                            MouseLeftButtonUp="ProfileChip_Click" ToolTip="Perfil que WinRaptor detecta según los ajustes que tienes activos">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="HeroProfileDot" Width="8" Height="8" VerticalAlignment="Center"/>
                                            <TextBlock Text="PERFIL ACTIVO" FontSize="10" FontWeight="Bold" Foreground="#A5B4FC" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="HeroProfileName" FontSize="13" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="HeroProfileCov" FontSize="11.5" Foreground="#94A3B8" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <Button Style="{StaticResource Primary}" Tag="1" Click="Profile_Click" Padding="22,12">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE945;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="Optimizar ahora"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Content="Deshacer todo" Click="UndoAll_Click" Margin="0,10,0,0" Background="#14FFFFFF" BorderBrush="#22FFFFFF"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Estadísticas -->
                        <UniformGrid Columns="4" Margin="0,0,0,8">
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                                <StackPanel>
                                    <DockPanel>
                                        <Border Style="{StaticResource IconBox}" DockPanel.Dock="Left"><TextBlock Text="&#xE7F8;" Style="{StaticResource Icon}"/></Border>
                                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="SISTEMA" Style="{StaticResource Label}"/>
                                            <TextBlock x:Name="OsText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock x:Name="OsSub" Foreground="{StaticResource Sub}" FontSize="12" Margin="0,12,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                                <StackPanel>
                                    <DockPanel>
                                        <Border Style="{StaticResource IconBox}" DockPanel.Dock="Left" Background="#0C2733"><TextBlock Text="&#xE950;" Style="{StaticResource Icon}" Foreground="#67E8F9"/></Border>
                                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="PROCESADOR" Style="{StaticResource Label}"/>
                                            <TextBlock x:Name="CpuText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock x:Name="CpuSub" Foreground="{StaticResource Sub}" FontSize="12" Margin="0,12,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                                <StackPanel>
                                    <DockPanel>
                                        <Border Style="{StaticResource IconBox}" DockPanel.Dock="Left" Background="#0F2E24"><TextBlock Text="&#xE964;" Style="{StaticResource Icon}" Foreground="#34D399"/></Border>
                                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="MEMORIA" Style="{StaticResource Label}"/>
                                            <TextBlock x:Name="RamText" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <ProgressBar x:Name="RamBar" Style="{StaticResource Bar}" Margin="0,16,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <DockPanel>
                                        <Border Style="{StaticResource IconBox}" DockPanel.Dock="Left" Background="#33260B"><TextBlock Text="&#xEDA2;" Style="{StaticResource Icon}" Foreground="#FBBF24"/></Border>
                                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="DISCO DEL SISTEMA" Style="{StaticResource Label}"/>
                                            <TextBlock x:Name="DiskText" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <ProgressBar x:Name="DiskBar" Style="{StaticResource Bar}" Margin="0,16,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Monitor en vivo -->
                        <DockPanel Margin="2,18,0,12">
                            <Border DockPanel.Dock="Right" Background="#0F2E24" CornerRadius="8" Padding="9,3" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="#34D399" VerticalAlignment="Center"/>
                                    <TextBlock Text="EN DIRECTO" Foreground="#34D399" FontSize="10" FontWeight="Bold" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Rendimiento en vivo" FontFamily="{StaticResource Display}" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Foreground="{StaticResource Sub}" Text="Uso real de CPU y memoria del último minuto. Pasa el ratón por la gráfica para ver cada segundo." Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                        <UniformGrid Columns="2">
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0" Padding="18,14,18,12">
                                <StackPanel>
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                                            <TextBlock x:Name="CpuLiveText" Text="—" FontFamily="{StaticResource Display}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            <TextBlock x:Name="CpuLiveSub" Foreground="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                        <Border Style="{StaticResource IconBox}" DockPanel.Dock="Left"><TextBlock Text="&#xE950;" Style="{StaticResource Icon}"/></Border>
                                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="CPU" Style="{StaticResource Label}"/>
                                            <TextBlock Text="Uso del procesador" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <local:LineChart x:Name="CpuLive" Height="84" Margin="0,14,0,0" Compact="True" FixedMax="100" Capacity="60" Unit="%"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBorder}" Padding="18,14,18,12">
                                <StackPanel>
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                                            <TextBlock x:Name="RamLiveText" Text="—" FontFamily="{StaticResource Display}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            <TextBlock x:Name="RamLiveSub" Foreground="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                        <Border Style="{StaticResource IconBox}" DockPanel.Dock="Left" Background="#0F2E24"><TextBlock Text="&#xE964;" Style="{StaticResource Icon}" Foreground="#34D399"/></Border>
                                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="MEMORIA" Style="{StaticResource Label}"/>
                                            <TextBlock Text="RAM en uso" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <local:LineChart x:Name="RamLive" Height="84" Margin="0,14,0,0" Compact="True" FixedMax="100" Capacity="60" Unit="%"
                                                     ColorA="#10B981" ColorB="#22D3EE"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Perfiles -->
                        <TextBlock Text="Perfiles de optimización" FontFamily="{StaticResource Display}" FontSize="18" FontWeight="Bold" Margin="2,18,0,4"/>
                        <TextBlock Foreground="{StaticResource Sub}" Margin="2,0,0,12" TextWrapping="Wrap"
                                   Text="Un perfil solo marca ajustes. Revísalos en cada sección y pulsa «Aplicar»."/>
                        <UniformGrid Columns="3">
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0" Padding="20,18">
                                <StackPanel>
                                    <Border Style="{StaticResource IconBox}" HorizontalAlignment="Left" Background="#0F2E24"><TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" Foreground="#34D399"/></Border>
                                    <TextBlock Text="Básico" FontSize="16" FontWeight="Bold" Margin="0,14,0,0"/>
                                    <TextBlock x:Name="ProfBasic" Foreground="#34D399" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                    <TextBlock Foreground="{StaticResource Sub}" TextWrapping="Wrap" Margin="0,8,0,16" Height="38"
                                               Text="Cambios seguros para cualquier equipo: privacidad, seguridad y menos distracciones."/>
                                    <Button Content="Seleccionar" Tag="1" Click="Profile_Click"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0" Padding="20,18">
                                <StackPanel>
                                    <Border Style="{StaticResource IconBox}" HorizontalAlignment="Left" Background="#33260B"><TextBlock Text="&#xEC4A;" Style="{StaticResource Icon}" Foreground="#FBBF24"/></Border>
                                    <TextBlock Text="Medio" FontSize="16" FontWeight="Bold" Margin="0,14,0,0"/>
                                    <TextBlock x:Name="ProfMedium" Foreground="#FBBF24" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                    <TextBlock Foreground="{StaticResource Sub}" TextWrapping="Wrap" Margin="0,8,0,16" Height="38"
                                               Text="Incluye el básico y añade rendimiento, red y energía."/>
                                    <Button Content="Seleccionar" Tag="2" Click="Profile_Click"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBorder}" Padding="20,18">
                                <StackPanel>
                                    <Border Style="{StaticResource IconBox}" HorizontalAlignment="Left" Background="#3A1518"><TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="#F87171"/></Border>
                                    <TextBlock Text="Avanzado" FontSize="16" FontWeight="Bold" Margin="0,14,0,0"/>
                                    <TextBlock x:Name="ProfHigh" Foreground="#F87171" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                    <TextBlock Foreground="{StaticResource Sub}" TextWrapping="Wrap" Margin="0,8,0,16" Height="38"
                                               Text="Todo, incluidos servicios y CPU al máximo. Solo si sabes qué dejas de tener."/>
                                    <Button Content="Seleccionar" Tag="3" Click="Profile_Click"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Perfiles propios -->
                        <TextBlock Text="Mis perfiles" FontFamily="{StaticResource Display}" FontSize="18" FontWeight="Bold" Margin="2,22,0,4"/>
                        <TextBlock Foreground="{StaticResource Sub}" Margin="2,0,0,12" TextWrapping="Wrap"
                                   Text="Guarda la selección actual con un nombre para volver a marcarla cuando quieras (por ejemplo «Gaming» o «Trabajo»)."/>
                        <Border Style="{StaticResource CardBorder}" Padding="16,12" Margin="0,0,0,10">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Click="SaveProfile_Click" Style="{StaticResource Primary}" Padding="16,8" Margin="10,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74E;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Guardar selección"/>
                                    </StackPanel>
                                </Button>
                                <Grid Height="40">
                                    <TextBox x:Name="ProfileNameBox" Style="{StaticResource Search}"/>
                                    <TextBlock Text="&#xE77B;" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Muted}" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                </Grid>
                            </DockPanel>
                        </Border>
                        <ItemsControl x:Name="MyProfilesList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="3" VerticalAlignment="Top"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border local:Motion.Stagger="True" Style="{StaticResource CardBorder}" Margin="0,0,10,10" Padding="16,14">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="Marcar" Tag="{Binding}" Click="LoadProfile_Click" Padding="12,6" FontSize="12"/>
                                                <Button Content="&#xE74D;" FontFamily="{StaticResource Icons}" Tag="{Binding}" Click="DeleteProfile_Click"
                                                        Padding="10,6" Margin="6,0,0,0" ToolTip="Eliminar perfil"/>
                                            </StackPanel>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Summary}" Foreground="{StaticResource Muted}" FontSize="11"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Lista de ajustes ===== -->
                <DockPanel x:Name="TweaksPanel" Grid.Row="2" Visibility="Collapsed" Margin="32,0,26,0">
                    <StackPanel x:Name="AnalysisStrip" DockPanel.Dock="Top" Margin="0,0,6,16" Visibility="Collapsed">
                        <DockPanel Margin="2,0,0,10">
                            <TextBlock x:Name="AnalysisStripHint" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" FontSize="11.5" VerticalAlignment="Center"/>
                            <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource Icons}" Foreground="#A78BFA" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="ANÁLISIS DE ESTA SECCIÓN" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <UniformGrid x:Name="AnalysisStripButtons" Rows="1"/>
                    </StackPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,6,14">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Marcar todos" Click="SelectAllVisible_Click" Padding="12,6" FontSize="12"/>
                            <Button Content="Desmarcar" Click="SelectNoneVisible_Click" Padding="12,6" FontSize="12" Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="ListCount" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,14">
                        <ItemsControl x:Name="TweakList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border local:Motion.Stagger="True" Margin="0,0,0,10" Padding="20,16" Opacity="{Binding CardOpacity}">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource CardBorder}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#6D4FE0"/>
                                                        <Setter Property="Background" Value="#17152A"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <WrapPanel>
                                                    <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="SemiBold" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                    <Border Background="{Binding RiskBg}" CornerRadius="7" Padding="8,2" VerticalAlignment="Center" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding RiskText}" Foreground="{Binding RiskFg}" FontSize="11" FontWeight="SemiBold"/>
                                                    </Border>
                                                    <Border Background="#1A1F2A" CornerRadius="7" Padding="8,2" VerticalAlignment="Center" Visibility="{Binding RestartVisibility}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Sub}" FontSize="10" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding RestartText}" Foreground="{StaticResource Sub}" FontSize="11" Margin="5,0,0,0"/>
                                                        </StackPanel>
                                                    </Border>
                                                </WrapPanel>
                                                <TextBlock Text="{Binding Desc}" Foreground="{StaticResource Sub}" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="19"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding BreaksVisibility}">
                                                    <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource Icons}" Foreground="#F59E0B" FontSize="12" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding BreaksText}" Foreground="#F5B754" FontSize="12" Margin="6,0,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                                                <StackPanel VerticalAlignment="Center" MinWidth="104">
                                                    <Border Background="{Binding StatusBg}" CornerRadius="8" Padding="10,3" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="12" FontWeight="SemiBold"/>
                                                    </Border>
                                                    <Button Style="{StaticResource Link}" Content="Deshacer" Visibility="{Binding UndoVisibility}"
                                                            Tag="{Binding}" Click="UndoOne_Click" HorizontalAlignment="Right" Margin="0,6,4,0"/>
                                                </StackPanel>
                                                <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding IsSelected}" Margin="20,0,0,0" IsEnabled="{Binding IsAvailable}"
                                                          VerticalAlignment="Center" ToolTip="Seleccionar para aplicar o deshacer"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <!-- ===== Apps preinstaladas ===== -->
                <ScrollViewer x:Name="AppsPanel" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="32,0,26,14">
                    <StackPanel x:Name="AppsStack">
                        <DockPanel Margin="0,0,10,12">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <Button Style="{StaticResource Primary}" Click="ScanApps_Click" Padding="16,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Buscar apps"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="AppsMarkRec" Click="AppsMarkRecommended_Click" Margin="10,0,0,0" Padding="14,8" IsEnabled="False"
                                        ToolTip="Marca solo las que WinRaptor recomienda quitar a cualquiera">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Marcar recomendadas"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="AppsRemoveBtn" Click="RemoveApps_Click" Margin="10,0,0,0" Padding="14,8" IsEnabled="False">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74D;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="AppsRemoveText" Text="Desinstalar seleccionadas"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock x:Name="AppsSummary" Foreground="{StaticResource Sub}" VerticalAlignment="Center" Margin="16,0,0,0" TextWrapping="Wrap"/>
                        </DockPanel>

                        <!-- Qué está protegido -->
                        <Border CornerRadius="14" Padding="16,12" Margin="0,0,10,12" Background="#0E2620" BorderBrush="#1F5C45" BorderThickness="1">
                            <DockPanel>
                                <CheckBox x:Name="AppsDeprovision" DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="True" VerticalAlignment="Center" Margin="16,0,0,0"
                                          ToolTip="También las quita de la imagen de Windows, para que no vuelvan con las grandes actualizaciones ni en usuarios nuevos">
                                    <TextBlock Text="Que no vuelvan a instalarse" Foreground="#CBD5E1" FontSize="12"/>
                                </CheckBox>
                                <TextBlock DockPanel.Dock="Left" Text="&#xEA18;" FontFamily="{StaticResource Icons}" FontSize="20" Foreground="#34D399" VerticalAlignment="Center"/>
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Lo necesario está protegido" FontWeight="SemiBold" Foreground="#A7F3D0"/>
                                    <TextBlock Foreground="#94A3B8" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                                               Text="La Microsoft Store, winget, Seguridad de Windows, Fotos, Calculadora, Bloc de notas, Recortes, Paint, Edge, los códecs y los componentes del sistema no se pueden quitar desde aquí. Solo aparecen apps de una lista revisada y todas se reinstalan desde la Store."/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border x:Name="AppsEmpty" Style="{StaticResource CardBorder}" Margin="0,0,10,10" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource IconBox}" Background="#0F2E24"><TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" Foreground="#34D399"/></Border>
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="No queda ninguna app innecesaria" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="Tu Windows ya está limpio de apps de serie que no hacen falta." Foreground="{StaticResource Sub}" FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <ItemsControl x:Name="AppsGroups">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4,0,4">
                                        <DockPanel Margin="2,8,10,10">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" Foreground="#A78BFA" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Display}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><UniformGrid Columns="2" VerticalAlignment="Top"/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border local:Motion.Stagger="True" Margin="0,0,10,10" Padding="16,12">
                                                        <Border.Style>
                                                            <Style TargetType="Border" BasedOn="{StaticResource CardBorder}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="#6D4FE0"/>
                                                                        <Setter Property="Background" Value="#17152A"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <DockPanel>
                                                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                                            <Border DockPanel.Dock="Left" Style="{StaticResource IconBox}" Width="36" Height="36" VerticalAlignment="Top">
                                                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="15"/>
                                                            </Border>
                                                            <StackPanel Margin="12,0,0,0">
                                                                <WrapPanel>
                                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                    <Border Background="{Binding AdviceBg}" CornerRadius="6" Padding="7,1" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding AdviceText}" Foreground="{Binding AdviceFg}" FontSize="10.5" FontWeight="SemiBold"/>
                                                                    </Border>
                                                                </WrapPanel>
                                                                <TextBlock Text="{Binding Desc}" Foreground="{StaticResource Sub}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                                <TextBlock Text="{Binding Package}" Foreground="#4B5568" FontSize="10.5" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Quitadas con WinRaptor -->
                        <StackPanel x:Name="AppsRemovedBox" Visibility="Collapsed" Margin="0,10,10,0">
                            <TextBlock Text="QUITADAS CON WINRAPTOR" Style="{StaticResource Label}" Margin="2,0,0,10"/>
                            <ItemsControl x:Name="AppsRemoved">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8" Padding="16,10">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Tag="{Binding}" Click="ReinstallApp_Click" Padding="12,6" FontSize="12" ToolTip="Abre la app en la Microsoft Store para volver a instalarla">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE896;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="11"/>
                                                        <TextBlock Text="Reinstalar"/>
                                                    </StackPanel>
                                                </Button>
                                                <TextBlock Text="&#xE74D;" DockPanel.Dock="Left" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                                                <TextBlock VerticalAlignment="Center" Margin="12,0,0,0">
                                                    <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="   quitada el " Foreground="#64748B"/><Run Text="{Binding When, Mode=OneWay}" Foreground="#64748B"/>
                                                </TextBlock>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Protegidas en este equipo -->
                        <Border x:Name="AppsProtectedBox" Style="{StaticResource CardBorder}" Margin="0,10,10,10" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="PROTEGIDAS EN TU EQUIPO" Style="{StaticResource Label}"/>
                                <TextBlock Text="Estas apps y componentes son necesarios y WinRaptor nunca los quitará." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,2,0,10"/>
                                <ItemsControl x:Name="AppsProtected">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#0F2E24" CornerRadius="8" Padding="9,3" Margin="0,0,8,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE72E;" FontFamily="{StaticResource Icons}" Foreground="#34D399" FontSize="10" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding}" Foreground="#A7F3D0" FontSize="12" Margin="6,0,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Análisis ===== -->
                <DockPanel x:Name="AnalysisPanel" Grid.Row="2" Visibility="Collapsed" Margin="32,0,26,14">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,6,12">
                        <Button Click="AnalysisBack_Click" Padding="12,7" FontSize="12" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72B;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11"/>
                                <TextBlock x:Name="AnalysisBackText" Text="Volver"/>
                            </StackPanel>
                        </Button>
                    </DockPanel>
                    <UniformGrid DockPanel.Dock="Top" Columns="5" Margin="0,0,6,14" x:Name="AnalysisTabs">
                        <Button Tag="ping" Click="AnalysisTab_Click" Margin="0,0,10,0" Padding="16,14" HorizontalContentAlignment="Left">
                            <StackPanel>
                                <TextBlock Text="&#xE701;" FontFamily="{StaticResource Icons}" FontSize="20" Foreground="#67E8F9"/>
                                <TextBlock Text="Latencia de red" FontSize="14" Margin="0,10,0,0"/>
                                <TextBlock Text="Ping, jitter, pérdida y bufferbloat" FontSize="11" FontWeight="Normal" Foreground="{StaticResource Sub}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Button>
                        <Button Tag="dns" Click="AnalysisTab_Click" Margin="0,0,10,0" Padding="16,14" HorizontalContentAlignment="Left">
                            <StackPanel>
                                <TextBlock Text="&#xE774;" FontFamily="{StaticResource Icons}" FontSize="20" Foreground="#34D399"/>
                                <TextBlock Text="DNS más rápido" FontSize="14" Margin="0,10,0,0"/>
                                <TextBlock Text="Compara 7 DNS y aplica el mejor" FontSize="11" FontWeight="Normal" Foreground="{StaticResource Sub}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Button>
                        <Button Tag="stutter" Click="AnalysisTab_Click" Margin="0,0,10,0" Padding="16,14" HorizontalContentAlignment="Left">
                            <StackPanel>
                                <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource Icons}" FontSize="20" Foreground="#FBBF24"/>
                                <TextBlock Text="Microtirones" FontSize="14" Margin="0,10,0,0"/>
                                <TextBlock Text="Latencia del sistema y drivers (DPC)" FontSize="11" FontWeight="Normal" Foreground="{StaticResource Sub}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Button>
                        <Button Tag="slow" Click="AnalysisTab_Click" Margin="0,0,10,0" Padding="16,14" HorizontalContentAlignment="Left">
                            <StackPanel>
                                <TextBlock Text="&#xEC4A;" FontFamily="{StaticResource Icons}" FontSize="20" Foreground="#F87171"/>
                                <TextBlock Text="¿Por qué va lento?" FontSize="14" Margin="0,10,0,0"/>
                                <TextBlock Text="Cuellos de botella y qué los causa" FontSize="11" FontWeight="Normal" Foreground="{StaticResource Sub}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Button>
                        <Button Tag="display" Click="AnalysisTab_Click" Padding="16,14" HorizontalContentAlignment="Left">
                            <StackPanel>
                                <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource Icons}" FontSize="20" Foreground="#A78BFA"/>
                                <TextBlock Text="Pantalla y gráficos" FontSize="14" Margin="0,10,0,0"/>
                                <TextBlock Text="Hz, resolución, monitores y GPU" FontSize="11" FontWeight="Normal" Foreground="{StaticResource Sub}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                        <StackPanel>
                            <Border x:Name="AnalysisIntro" Style="{StaticResource CardBorder}">
                                <TextBlock Foreground="{StaticResource Sub}" TextWrapping="Wrap"
                                           Text="Elige un análisis. Cada uno tarda entre 10 y 25 segundos y te explica qué ha encontrado y qué hacer."/>
                            </Border>
                            <StackPanel x:Name="AnalysisResult" Visibility="Collapsed">
                                <!-- Veredicto -->
                                <Border CornerRadius="16" Padding="22,18" Margin="0,0,0,12" BorderThickness="1" x:Name="VerdictCard">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Style="{StaticResource IconBox}" Width="48" Height="48" CornerRadius="14" x:Name="VerdictIconBox">
                                            <TextBlock x:Name="VerdictIcon" Style="{StaticResource Icon}" FontSize="22"/>
                                        </Border>
                                        <Button DockPanel.Dock="Right" Click="RerunAnalysis_Click" VerticalAlignment="Center" Padding="14,7">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="Repetir"/>
                                            </StackPanel>
                                        </Button>
                                        <StackPanel Margin="16,0,16,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="VerdictTitle" FontFamily="{StaticResource Display}" FontSize="18" FontWeight="Bold"/>
                                            <TextBlock x:Name="VerdictText" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <!-- Métricas -->
                                <ItemsControl x:Name="MetricsList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border local:Motion.Stagger="True" Style="{StaticResource CardBorder}" Margin="0,0,10,10" Padding="16,12">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <Ellipse DockPanel.Dock="Left" Width="6" Height="6" Fill="{Binding DotBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Label}" TextTrimming="CharacterEllipsis"/>
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding Value}" Foreground="{Binding ValueBrush}" FontFamily="{StaticResource Display}" FontSize="17" FontWeight="Bold" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- Gráfica -->
                                <Border x:Name="ChartCard" Style="{StaticResource CardBorder}" Margin="0,0,10,10" Padding="20,16,20,12">
                                    <StackPanel>
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="16" Height="3" CornerRadius="2" Background="{StaticResource AccentGrad}" VerticalAlignment="Center"/>
                                                <TextBlock Text="Medida" Foreground="{StaticResource Sub}" FontSize="11" Margin="6,0,14,0"/>
                                                <Line X1="0" X2="16" Y1="0" Y2="0" Stroke="#FBBF24" StrokeThickness="1.5" StrokeDashArray="2 2" VerticalAlignment="Center"/>
                                                <TextBlock Text="Límite" Foreground="{StaticResource Sub}" FontSize="11" Margin="6,0,14,0"/>
                                                <Ellipse Width="6" Height="6" Fill="#F87171" VerticalAlignment="Center"/>
                                                <TextBlock Text="Por encima" Foreground="{StaticResource Sub}" FontSize="11" Margin="6,0,0,0"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock x:Name="ChartLabel" Style="{StaticResource Label}"/>
                                                <TextBlock Text="Pasa el ratón por la gráfica para ver cada valor" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <local:LineChart x:Name="Chart" Height="210" Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="BarsCard" Style="{StaticResource CardBorder}" Margin="0,0,10,10" Padding="20,16,20,10">
                                    <StackPanel>
                                        <TextBlock x:Name="BarsLabel" Style="{StaticResource Label}"/>
                                        <local:BarChart x:Name="Bars" Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>
                                <!-- Pantallas -->
                                <StackPanel x:Name="MonitorsBox" Visibility="Collapsed" Margin="0,0,10,0">
                                    <TextBlock Text="TUS PANTALLAS" Style="{StaticResource Label}" Margin="2,4,0,10"/>
                                    <ItemsControl x:Name="MonitorsList">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><UniformGrid Columns="2" VerticalAlignment="Top"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border local:Motion.Stagger="True" Style="{StaticResource CardBorder}" Margin="0,0,10,10" Padding="18,14">
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Visibility="{Binding BoostVisibility}" Content="{Binding BoostText}"
                                                                Tag="{Binding}" Click="BoostHz_Click" Padding="14,8" VerticalAlignment="Center" Margin="12,0,0,0"
                                                                ToolTip="Sube la frecuencia al máximo que admite. Se revierte solo si no confirmas en 15 segundos."/>
                                                        <Border DockPanel.Dock="Left" Style="{StaticResource IconBox}" Width="42" Height="42" VerticalAlignment="Top">
                                                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="18"/>
                                                        </Border>
                                                        <StackPanel Margin="14,0,0,0">
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Mode}" Foreground="{Binding HzBrush}" FontFamily="{StaticResource Display}" FontSize="19" FontWeight="Bold" Margin="0,3,0,0"/>
                                                            <TextBlock Text="{Binding Details}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <!-- DNS -->
                                <StackPanel x:Name="DnsBox" Visibility="Collapsed" Margin="0,0,10,0">
                                    <DockPanel Margin="2,4,0,10">
                                        <Button x:Name="RestoreDnsButton" DockPanel.Dock="Right" Click="RestoreDns_Click" Padding="14,6">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE7A7;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="Restaurar DNS original"/>
                                            </StackPanel>
                                        </Button>
                                        <TextBlock Text="SERVIDORES DNS (del más rápido al más lento)" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <ItemsControl x:Name="DnsList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border local:Motion.Stagger="True" Style="{StaticResource CardBorder}" Margin="0,0,0,8" Padding="18,12">
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Visibility="{Binding UseVisibility}" Tag="{Binding}" Click="UseDns_Click" Padding="14,6" Margin="16,0,0,0" Content="Usar este DNS" VerticalAlignment="Center"/>
                                                        <StackPanel DockPanel.Dock="Right" Width="110" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding MedianText}" Foreground="{Binding MedianBrush}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                            <TextBlock Text="{Binding Reliability}" Foreground="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Right"/>
                                                        </StackPanel>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                                <Border Visibility="{Binding BestVisibility}" Background="#0F2E24" CornerRadius="6" Padding="7,1" Margin="10,0,0,0">
                                                                    <TextBlock Text="Más rápido" Foreground="#34D399" FontSize="11" FontWeight="SemiBold"/>
                                                                </Border>
                                                                <Border Visibility="{Binding CurrentVisibility}" Background="#0C2733" CornerRadius="6" Padding="7,1" Margin="8,0,0,0">
                                                                    <TextBlock Text="En uso" Foreground="#67E8F9" FontSize="11" FontWeight="SemiBold"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0">
                                                                <Run Text="{Binding Ips, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding Note, Mode=OneWay}"/>
                                                            </TextBlock>
                                                            <Grid Margin="0,9,0,0" Height="6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="{Binding BarStar}"/>
                                                                    <ColumnDefinition Width="{Binding RestStar}"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Border Grid.ColumnSpan="2" CornerRadius="3" Background="#1C2230"/>
                                                                <Border CornerRadius="3" Background="{Binding BarBrush}" RenderTransformOrigin="0,0.5">
                                                                    <Border.RenderTransform><ScaleTransform ScaleX="0"/></Border.RenderTransform>
                                                                    <Border.Triggers>
                                                                        <EventTrigger RoutedEvent="Loaded">
                                                                            <BeginStoryboard>
                                                                                <Storyboard>
                                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.9" BeginTime="0:0:0.15">
                                                                                        <DoubleAnimation.EasingFunction><QuinticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                                    </DoubleAnimation>
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </EventTrigger>
                                                                    </Border.Triggers>
                                                                </Border>
                                                            </Grid>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <!-- Hallazgos -->
                                <TextBlock Text="QUÉ HE ENCONTRADO" Style="{StaticResource Label}" Margin="2,8,0,10"/>
                                <ItemsControl x:Name="FindingsList" Margin="0,0,10,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border local:Motion.Stagger="True" Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Left" Style="{StaticResource IconBox}" Background="{Binding IconBg}" VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" Foreground="{Binding IconFg}"/>
                                                    </Border>
                                                    <StackPanel Margin="14,0,0,0">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"/>
                                                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Sub}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                        <TextBlock Text="{Binding Advice}" Visibility="{Binding AdviceVisibility}" Foreground="#C4B5FD" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>

                <!-- ===== Modo juego ===== -->
                <ScrollViewer x:Name="GamePanel" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="32,0,26,18">
                    <StackPanel x:Name="GameStack">
                        <!-- Destacado: el último juego + estado del modo juego -->
                        <Grid x:Name="FeatHero" Height="300" Margin="0,0,10,0">
                            <Grid.Clip><RectangleGeometry x:Name="FeatClip" RadiusX="20" RadiusY="20" Rect="0,0,2000,300"/></Grid.Clip>
                            <Border x:Name="FeatBg" Background="#141A2E"/>
                            <Border>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#F20B0D12" Offset="0"/>
                                        <GradientStop Color="#B30B0D12" Offset="0.45"/>
                                        <GradientStop Color="#330B0D12" Offset="0.75"/>
                                        <GradientStop Color="#990B0D12" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#000B0D12" Offset="0.5"/>
                                        <GradientStop Color="#D90B0D12" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border CornerRadius="20" BorderThickness="1" BorderBrush="#33FFFFFF"/>

                            <Grid Margin="32,26,24,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="320"/>
                                </Grid.ColumnDefinitions>
                                <!-- Juego destacado -->
                                <StackPanel x:Name="FeatInfo" VerticalAlignment="Bottom" Margin="0,0,24,0">
                                    <TextBlock x:Name="FeatLabel" Text="SEGUIR JUGANDO" FontSize="11" FontWeight="Bold" Foreground="#C4B5FD"/>
                                    <Image x:Name="FeatLogo" MaxHeight="110" MaxWidth="380" HorizontalAlignment="Left" Margin="0,10,0,0" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality">
                                        <Image.Effect><DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="0" Opacity="0.7"/></Image.Effect>
                                    </Image>
                                    <TextBlock x:Name="FeatTitle" FontFamily="{StaticResource Display}" FontSize="34" FontWeight="Bold" Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left">
                                        <TextBlock.Effect><DropShadowEffect Color="Black" BlurRadius="14" ShadowDepth="0" Opacity="0.8"/></TextBlock.Effect>
                                    </TextBlock>
                                    <TextBlock x:Name="FeatMeta" Foreground="#CBD5E1" Margin="0,8,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                        <Button x:Name="FeatPlay" Style="{StaticResource Primary}" Click="FeatPlay_Click" Padding="26,12" FontSize="15">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE768;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <TextBlock Text="Jugar"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="FeatOpen" Click="FeatOpen_Click" Margin="10,0,0,0" Padding="16,12" Background="#33FFFFFF" BorderBrush="#33FFFFFF"
                                                ToolTip="Abre el juego sin activar el modo juego">
                                            <TextBlock Text="Abrir sin modo juego"/>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Estado del modo juego -->
                                <Border x:Name="GameHero" Grid.Column="1" CornerRadius="16" Padding="20,18" BorderThickness="1" BorderBrush="#33FFFFFF"
                                        Background="#B30E1220" VerticalAlignment="Center">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource AccentGrad}">
                                                <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource Icons}" FontSize="17" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse x:Name="GameDot" Width="7" Height="7" Fill="#34D399" VerticalAlignment="Center" Margin="0,0,6,0" Visibility="Collapsed"/>
                                                    <TextBlock x:Name="GameState" Text="MODO JUEGO" FontSize="10.5" FontWeight="Bold" Foreground="#A5B4FC"/>
                                                </StackPanel>
                                                <TextBlock x:Name="GameTitle" Text="Listo para activar" FontWeight="Bold" FontSize="15" Margin="0,1,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock x:Name="GameSub" Foreground="#CBD5E1" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="17"/>
                                        <WrapPanel x:Name="GameStats" Margin="0,10,0,0" Visibility="Collapsed">
                                            <Border Background="#1A34D399" CornerRadius="6" Padding="7,2" Margin="0,0,6,6"><TextBlock x:Name="GameStatApps" Foreground="#34D399" FontSize="11" FontWeight="SemiBold"/></Border>
                                            <Border Background="#1A34D399" CornerRadius="6" Padding="7,2" Margin="0,0,6,6"><TextBlock x:Name="GameStatSvc" Foreground="#34D399" FontSize="11" FontWeight="SemiBold"/></Border>
                                            <Border Background="#1A34D399" CornerRadius="6" Padding="7,2" Margin="0,0,6,6"><TextBlock x:Name="GameStatRam" Foreground="#34D399" FontSize="11" FontWeight="SemiBold"/></Border>
                                            <Border Background="#1A34D399" CornerRadius="6" Padding="7,2" Margin="0,0,6,6"><TextBlock x:Name="GameStatPower" Foreground="#34D399" FontSize="11" FontWeight="SemiBold"/></Border>
                                        </WrapPanel>
                                        <Button x:Name="GameStartBtn" Style="{StaticResource Primary}" Click="GameStart_Click" Padding="16,10" Margin="0,14,0,0" HorizontalAlignment="Stretch">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE945;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="Activar modo juego"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="GameEndBtn" Click="GameEnd_Click" Padding="16,10" Margin="0,14,0,0" Visibility="Collapsed" Background="#33260B" BorderBrush="#6B5216">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE7A7;" FontFamily="{StaticResource Icons}" Foreground="#FBBF24" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="Terminar y restaurar" Foreground="#FBBF24"/>
                                            </StackPanel>
                                        </Button>
                                        <CheckBox x:Name="GameAutoMode" Style="{StaticResource Toggle}" IsChecked="True" Margin="0,12,0,0"
                                                  ToolTip="Al pulsar «Jugar», primero activa el modo juego y después abre el juego">
                                            <TextBlock Text="Activarlo solo al pulsar «Jugar»" Foreground="#CBD5E1" FontSize="12"/>
                                        </CheckBox>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- Biblioteca: filtros y búsqueda -->
                        <DockPanel Margin="0,22,10,6">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Grid Width="220" Height="36">
                                    <TextBox x:Name="GameSearch" Style="{StaticResource Search}" TextChanged="GameSearch_Changed"/>
                                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Muted}" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                    <TextBlock x:Name="GameSearchHint" Text="Buscar juego…" Foreground="{StaticResource Muted}" Margin="39,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                </Grid>
                                <Button Click="GameAdd_Click" Margin="10,0,0,0" Padding="12,8" FontSize="12" ToolTip="Añade un juego que no sea de Steam, Epic ni de la Microsoft Store (elige su .exe o su acceso directo)">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="11"/>
                                        <TextBlock Text="Añadir juego"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Tu biblioteca" FontFamily="{StaticResource Display}" FontSize="19" FontWeight="Bold"/>
                                <TextBlock x:Name="GameLibHint" Text="Buscando tus juegos…" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                        <WrapPanel x:Name="GameFilterBar" Margin="0,8,10,14"/>

                        <ItemsControl x:Name="GameLibraryList" Margin="0,0,0,6">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Card" local:Motion.Stagger="True" local:Motion.Hover="True" Width="148" Margin="0,0,14,18" Cursor="Hand"
                                            Background="Transparent" MouseLeftButtonUp="GameCard_Click" MouseEnter="GameCard_Hover" Tag="{Binding}" ToolTip="{Binding Title}">
                                        <StackPanel>
                                            <Grid Width="148" Height="222">
                                                <Grid.Clip><RectangleGeometry Rect="0,0,148,222" RadiusX="12" RadiusY="12"/></Grid.Clip>
                                                <Border Background="{Binding Placeholder}"/>
                                                <Image Source="{Binding IconImage}" Visibility="{Binding BlurVisibility}" Stretch="UniformToFill" Opacity="0.55" Margin="-30">
                                                    <Image.Effect><BlurEffect Radius="34"/></Image.Effect>
                                                </Image>
                                                <Border Visibility="{Binding BlurVisibility}" Background="#550B0D12"/>
                                                <Border Width="84" Height="84" CornerRadius="18" Visibility="{Binding BlurVisibility}" ClipToBounds="True">
                                                    <Border.Effect><DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="4" Opacity="0.5"/></Border.Effect>
                                                    <Image Source="{Binding IconImage}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                </Border>
                                                <TextBlock Text="{Binding Initials}" Visibility="{Binding InitialsVisibility}" FontFamily="{StaticResource Display}" FontSize="42"
                                                           FontWeight="Bold" Foreground="#D9FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Border Background="{Binding CoverBrush}"/>
                                                <Border Background="{Binding SourceBg}" CornerRadius="6" Padding="7,2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8">
                                                    <TextBlock Text="{Binding Source}" FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                                                </Border>
                                                <Border x:Name="Play" Opacity="0" IsHitTestVisible="False">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#00000000" Offset="0.35"/>
                                                            <GradientStop Color="#E6070910" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,16" CornerRadius="18" Padding="18,8" Background="{StaticResource AccentGrad}">
                                                        <Border.Effect><DropShadowEffect Color="#8B5CF6" BlurRadius="16" ShadowDepth="0" Opacity="0.7"/></Border.Effect>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE768;" FontFamily="{StaticResource Icons}" Foreground="White" VerticalAlignment="Center"/>
                                                            <TextBlock Text="Jugar" Foreground="White" FontWeight="SemiBold" Margin="7,0,0,0"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Border>
                                                <Border x:Name="Ring" CornerRadius="12" BorderThickness="2" BorderBrush="#1FFFFFFF"/>
                                                <Button Visibility="{Binding RemoveVisibility}" Style="{StaticResource Chrome}" Width="28" Height="28" Content="&#xE711;"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4" Tag="{Binding}" Click="GameRemove_Click" ToolTip="Quitar de la lista"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="2,9,0,0" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding LastPlayedText}" Foreground="{StaticResource Muted}" FontSize="11" Margin="2,2,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Play" Property="Opacity" Value="1"/>
                                            <Setter TargetName="Ring" Property="BorderBrush" Value="#A78BFA"/>
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="GameNoResults" Text="Ningún juego coincide con la búsqueda." Foreground="{StaticResource Muted}" Margin="2,0,0,16" Visibility="Collapsed"/>

                        <!-- Qué hará el modo juego (resumen y opciones) -->
                        <Border Style="{StaticResource CardBorder}" local:Motion.Hover="False" Margin="0,4,10,10" Padding="18,13">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Click="GameOptToggle_Click" Padding="14,7" FontSize="12" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="GameOptToggleIcon" Text="&#xE70D;" FontFamily="{StaticResource Icons}" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="GameOptToggleText" Text="Personalizar"/>
                                    </StackPanel>
                                </Button>
                                <Border DockPanel.Dock="Left" Style="{StaticResource IconBox}" Width="36" Height="36">
                                    <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" FontSize="15"/>
                                </Border>
                                <StackPanel Margin="14,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="QUÉ HARÁ EL MODO JUEGO" Style="{StaticResource Label}"/>
                                    <TextBlock x:Name="GameOptSummary" Text="Detectando…" Foreground="{StaticResource Sub}" FontSize="12.5" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <StackPanel x:Name="GameOptBox" Visibility="Collapsed">
                            <Grid x:Name="GameOptions">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource CardBorder}" local:Motion.Hover="False" Margin="0,0,10,10" Padding="20,16" VerticalAlignment="Top">
                                    <StackPanel>
                                        <TextBlock Text="CERRAR APPS EN SEGUNDO PLANO" Style="{StaticResource Label}"/>
                                        <TextBlock Text="Liberan memoria y CPU. Las ventanas abiertas vienen sin marcar: actívalas solo si no las necesitas." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,2,0,12" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="GameAppsEmpty" Text="Detectando apps abiertas…" Foreground="{StaticResource Sub}" FontSize="12" Margin="0,0,0,8"/>
                                        <ItemsControl x:Name="GameApps">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,9">
                                                        <DockPanel>
                                                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="{Binding IsSelected}" VerticalAlignment="Center"/>
                                                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding Meta}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,11,0,0" Margin="0,4,0,0">
                                            <CheckBox x:Name="GameReopen" Style="{StaticResource Toggle}" IsChecked="True">
                                                <StackPanel>
                                                    <TextBlock Text="Volver a abrirlas al terminar" Foreground="{StaticResource Text}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="Solo las de segundo plano (OneDrive, Teams…), no las ventanas." Foreground="{StaticResource Muted}" FontSize="11"/>
                                                </StackPanel>
                                            </CheckBox>
                                        </Border>
                                        <Button x:Name="GameRedetect" Style="{StaticResource Link}" Content="Volver a detectar apps abiertas" Click="GameDetect_Click" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                                    </StackPanel>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <Border Style="{StaticResource CardBorder}" local:Motion.Hover="False" Margin="0,0,10,10" Padding="20,16">
                                        <StackPanel>
                                            <TextBlock Text="PAUSAR TAREAS DE FONDO" Style="{StaticResource Label}"/>
                                            <TextBlock Text="Se detienen mientras juegas y vuelven a arrancar al terminar. No se desactiva nada." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,2,0,12" TextWrapping="Wrap"/>
                                            <ItemsControl x:Name="GameServices">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,8">
                                                            <DockPanel>
                                                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanChange}" VerticalAlignment="Center"/>
                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding State}" Foreground="{Binding StateFg}" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                                <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                                                                    <TextBlock Text="{Binding Desc}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                                </StackPanel>
                                                            </DockPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource CardBorder}" local:Motion.Hover="False" Margin="0,0,10,10" Padding="20,16">
                                        <StackPanel>
                                            <TextBlock Text="AJUSTES DE LA PARTIDA" Style="{StaticResource Label}" Margin="0,0,0,8"/>
                                            <CheckBox x:Name="GamePower" Style="{StaticResource Toggle}" IsChecked="True" Margin="0,6" Click="GameOpt_Changed">
                                                <StackPanel>
                                                    <TextBlock Text="Plan de energía de máximo rendimiento" Foreground="{StaticResource Text}" FontWeight="SemiBold"/>
                                                    <TextBlock x:Name="GamePowerSub" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </CheckBox>
                                            <CheckBox x:Name="GameMem" Style="{StaticResource Toggle}" IsChecked="True" Margin="0,6" Click="GameOpt_Changed">
                                                <StackPanel>
                                                    <TextBlock Text="Liberar memoria en caché" Foreground="{StaticResource Text}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="Vacía la memoria «en espera» para que el juego tenga más RAM libre al cargar." Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </CheckBox>
                                            <CheckBox x:Name="GameSilence" Style="{StaticResource Toggle}" IsChecked="True" Margin="0,6" Click="GameOpt_Changed">
                                                <StackPanel>
                                                    <TextBlock Text="Silenciar notificaciones" Foreground="{StaticResource Text}" FontWeight="SemiBold"/>
                                                    <TextBlock x:Name="GameSilenceSub" Text="Nada de avisos a mitad de partida." Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </CheckBox>
                                            <CheckBox x:Name="GameTimer" Style="{StaticResource Toggle}" IsChecked="True" Margin="0,6" Click="GameOpt_Changed">
                                                <StackPanel>
                                                    <TextBlock Text="Temporizador de alta precisión" Foreground="{StaticResource Text}" FontWeight="SemiBold"/>
                                                    <TextBlock x:Name="GameTimerSub" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </CheckBox>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                            <Border CornerRadius="14" Padding="16,12" Margin="0,0,10,10" Background="#0E2620" BorderBrush="#1F5C45" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEA18;" FontFamily="{StaticResource Icons}" FontSize="18" Foreground="#34D399" VerticalAlignment="Center"/>
                                    <TextBlock Foreground="#94A3B8" FontSize="12" TextWrapping="Wrap" Margin="14,0,0,0" MaxWidth="880" VerticalAlignment="Center"
                                               Text="Nunca se cierran tus juegos, Steam, Epic, Battle.net, Riot, Roblox, EA, Ubisoft, Xbox, Discord ni los programas de tus drivers. Al terminar, servicios, plan de energía y notificaciones vuelven exactamente a como estaban, aunque WinRaptor se cierre a mitad de la partida."/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Consejos ===== -->
                <ScrollViewer x:Name="TipsPanel" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="32,0,26,14">
                    <StackPanel x:Name="TipsStack">
                        <!-- Salud del equipo -->
                        <Border CornerRadius="18" Padding="28,22" Margin="0,0,10,14" BorderThickness="1" BorderBrush="#352F66">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#251B4D" Offset="0"/>
                                    <GradientStop Color="#141A2E" Offset="0.55"/>
                                    <GradientStop Color="#0A2E3A" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="120" Height="120">
                                    <Ellipse Stroke="#262B45" StrokeThickness="10"/>
                                    <Path x:Name="TipsArc" StrokeThickness="10" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="#34D399">
                                        <Path.Effect><DropShadowEffect x:Name="TipsArcGlow" Color="#34D399" BlurRadius="16" ShadowDepth="0" Opacity="0.6"/></Path.Effect>
                                    </Path>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock x:Name="TipsScore" Text="—" FontFamily="{StaticResource Display}" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="salud" Foreground="#A5B4FC" FontSize="11" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="28,0,20,0" VerticalAlignment="Center">
                                    <TextBlock Text="ASESOR WINRAPTOR" FontSize="11" FontWeight="Bold" Foreground="#A5B4FC"/>
                                    <TextBlock x:Name="TipsTitle" FontFamily="{StaticResource Display}" FontSize="22" FontWeight="Bold" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="TipsSummary" Foreground="#CBD5E1" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    <WrapPanel Margin="0,12,0,0">
                                        <Border Background="#3A1518" CornerRadius="8" Padding="10,3" Margin="0,0,8,0">
                                            <TextBlock x:Name="TipsBad" Foreground="#F87171" FontSize="12" FontWeight="SemiBold"/>
                                        </Border>
                                        <Border Background="#33260B" CornerRadius="8" Padding="10,3" Margin="0,0,8,0">
                                            <TextBlock x:Name="TipsWarn" Foreground="#FBBF24" FontSize="12" FontWeight="SemiBold"/>
                                        </Border>
                                        <Border Background="#0C2733" CornerRadius="8" Padding="10,3">
                                            <TextBlock x:Name="TipsInfo" Foreground="#67E8F9" FontSize="12" FontWeight="SemiBold"/>
                                        </Border>
                                    </WrapPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <Button Style="{StaticResource Primary}" Click="TipsCheck_Click" Padding="20,11"
                                            ToolTip="Hace un diagnóstico y comprueba el punto de restauración para afinar los consejos">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="Revisar mi PC"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock x:Name="TipsCheckedAt" Foreground="#8892B0" FontSize="11" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Qué hacer ahora -->
                        <DockPanel Margin="2,4,10,10">
                            <Button x:Name="TipsRestoreHidden" DockPanel.Dock="Right" Style="{StaticResource Link}" Click="TipsShowHidden_Click" VerticalAlignment="Center"/>
                            <TextBlock Text="QUÉ HACER AHORA" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Border x:Name="TipsAllGood" Style="{StaticResource CardBorder}" Margin="0,0,10,10" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource IconBox}" Background="#0F2E24"><TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" Foreground="#34D399"/></Border>
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="No hay nada urgente" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="Tu PC está en buena forma. Abajo tienes sugerencias opcionales y los hábitos para mantenerlo así." Foreground="{StaticResource Sub}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <ItemsControl x:Name="TipsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border local:Motion.Stagger="True" Style="{StaticResource CardBorder}" Margin="0,0,10,10" Padding="18,14">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0">
                                                <Button Visibility="{Binding ActionVisibility}" Content="{Binding ActionText}" Tag="{Binding}" Click="TipAction_Click" Padding="14,7" MinWidth="130"/>
                                                <Button Style="{StaticResource Link}" Content="Ocultar" Tag="{Binding}" Click="TipDismiss_Click" HorizontalAlignment="Right" Margin="0,7,2,0"
                                                        ToolTip="No volver a mostrar este consejo"/>
                                            </StackPanel>
                                            <Border DockPanel.Dock="Left" Style="{StaticResource IconBox}" Background="{Binding Bg}" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" Foreground="{Binding Fg}"/>
                                            </Border>
                                            <StackPanel Margin="14,0,0,0">
                                                <WrapPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                    <Border Background="{Binding Bg}" CornerRadius="6" Padding="7,1" VerticalAlignment="Center" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding LevelText}" Foreground="{Binding Fg}" FontSize="10.5" FontWeight="SemiBold"/>
                                                    </Border>
                                                    <Border Visibility="{Binding SourceVisibility}" Background="#1A1F2A" CornerRadius="6" Padding="7,1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Source}" Foreground="{StaticResource Muted}" FontSize="10.5"/>
                                                    </Border>
                                                </WrapPanel>
                                                <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Sub}" TextWrapping="Wrap" Margin="0,5,0,0" LineHeight="19"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,7,0,0" Visibility="{Binding AdviceVisibility}">
                                                    <TextBlock Text="&#xE82F;" FontFamily="{StaticResource Icons}" Foreground="#C4B5FD" FontSize="12" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding Advice}" Foreground="#C4B5FD" FontSize="12" Margin="7,0,0,0" TextWrapping="Wrap" MaxWidth="780"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Hábitos -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,8,10,10" Padding="20,16">
                            <StackPanel>
                                <TextBlock Text="HÁBITOS PARA QUE TU PC VAYA SIEMPRE BIEN" Style="{StaticResource Label}"/>
                                <TextBlock Text="Si cumples estos siete, tu equipo se mantiene rápido sin esfuerzo." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,2,0,10"/>
                                <ItemsControl x:Name="HabitsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,9">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/>
                                                    <Border DockPanel.Dock="Left" Width="22" Height="22" CornerRadius="11" Background="{Binding Bg}" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Mark}" Foreground="{Binding Fg}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Title}" Margin="12,0,12,0" VerticalAlignment="Center"/>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Drivers ===== -->
                <ScrollViewer x:Name="DriversPanel" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="32,0,26,14">
                    <StackPanel x:Name="DrvStack">
                        <DockPanel Margin="0,0,6,14">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <Button Style="{StaticResource Primary}" Click="DriverScan_Click" Padding="16,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Buscar actualizaciones"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="DriverInstallBtn" Click="DriverInstall_Click" Margin="10,0,0,0" Padding="16,8" IsEnabled="False">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE896;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="DriverInstallText" Text="Instalar seleccionados"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="DriverRescan_Click" Margin="10,0,0,0" Padding="14,8" ToolTip="Vuelve a detectar el hardware, como «Buscar cambios de hardware» del Administrador de dispositivos">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE772;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Detectar hardware"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock x:Name="DriverSummary" Foreground="{StaticResource Sub}" VerticalAlignment="Center" Margin="16,0,0,0" TextWrapping="Wrap"/>
                        </DockPanel>

                        <UniformGrid Columns="4" Margin="0,0,0,4">
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,10,10" Padding="18,14">
                                <StackPanel>
                                    <TextBlock Text="ACTUALIZACIONES" Style="{StaticResource Label}"/>
                                    <TextBlock x:Name="DrvKpiUpdates" Text="—" FontFamily="{StaticResource Display}" FontSize="26" FontWeight="Bold" Margin="0,4,0,0"/>
                                    <TextBlock Text="drivers nuevos en Windows Update" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,10,10" Padding="18,14">
                                <StackPanel>
                                    <TextBlock Text="CON PROBLEMAS" Style="{StaticResource Label}"/>
                                    <TextBlock x:Name="DrvKpiProblems" Text="—" FontFamily="{StaticResource Display}" FontSize="26" FontWeight="Bold" Margin="0,4,0,0"/>
                                    <TextBlock Text="dispositivos con error o sin driver" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,10,10" Padding="18,14">
                                <StackPanel>
                                    <TextBlock Text="ANTIGUOS" Style="{StaticResource Label}"/>
                                    <TextBlock x:Name="DrvKpiOld" Text="—" FontFamily="{StaticResource Display}" FontSize="26" FontWeight="Bold" Margin="0,4,0,0"/>
                                    <TextBlock Text="drivers importantes con más de 3 años" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,10,10" Padding="18,14">
                                <StackPanel>
                                    <TextBlock Text="DE FABRICANTES" Style="{StaticResource Label}"/>
                                    <TextBlock x:Name="DrvKpiTotal" Text="—" FontFamily="{StaticResource Display}" FontSize="26" FontWeight="Bold" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="DrvKpiTotalSub" Text="drivers instalados" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Actualizaciones oficiales -->
                        <DockPanel Margin="2,10,10,10">
                            <TextBlock DockPanel.Dock="Right" Text="Oficiales, firmados por Microsoft y el fabricante" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="ACTUALIZACIONES DE DRIVERS" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Border x:Name="DrvSearching" Style="{StaticResource CardBorder}" Margin="0,0,10,10" Visibility="Collapsed">
                            <DockPanel>
                                <Grid Width="34" Height="34" DockPanel.Dock="Left">
                                    <Ellipse Stroke="#1C2230" StrokeThickness="3.5"/>
                                    <Ellipse Stroke="{StaticResource AccentGrad}" StrokeThickness="3.5" StrokeDashArray="5 9" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform><RotateTransform x:Name="DrvSpinRot"/></Ellipse.RenderTransform>
                                    </Ellipse>
                                </Grid>
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Buscando drivers nuevos en Windows Update…" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="DrvSearchHint" Text="La primera búsqueda puede tardar unos minutos. Mientras tanto puedes seguir usando WinRaptor." Foreground="{StaticResource Sub}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border x:Name="DrvNoUpdates" Style="{StaticResource CardBorder}" Margin="0,0,10,10" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource IconBox}" Background="#0F2E24"><TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" Foreground="#34D399"/></Border>
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Tus drivers están al día" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="Windows Update no tiene drivers más nuevos para tu equipo." Foreground="{StaticResource Sub}" FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border x:Name="DrvError" Style="{StaticResource CardBorder}" Margin="0,0,10,10" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource IconBox}" Background="#33260B"><TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="#FBBF24"/></Border>
                                <TextBlock x:Name="DrvErrorText" Margin="14,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="700"/>
                            </StackPanel>
                        </Border>
                        <ItemsControl x:Name="DrvUpdates" Margin="0,0,10,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border local:Motion.Stagger="True" Style="{StaticResource CardBorder}" Margin="0,0,0,8" Padding="18,12">
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                            <Border DockPanel.Dock="Right" Visibility="{Binding StatusVisibility}" Background="#1A1F2A" CornerRadius="8" Padding="10,3" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Status}" Foreground="{Binding StatusFg}" FontSize="12" FontWeight="SemiBold"/>
                                            </Border>
                                            <Border DockPanel.Dock="Left" Style="{StaticResource IconBox}" Width="36" Height="36" Background="#0C2733">
                                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="15" Foreground="#67E8F9"/>
                                            </Border>
                                            <StackPanel Margin="12,0,10,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Meta}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding InstalledText}" Visibility="{Binding OlderVisibility}" Foreground="#FBBF24" FontSize="11.5" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Problemas -->
                        <StackPanel x:Name="DrvProblemsBox" Visibility="Collapsed" Margin="0,6,10,0">
                            <TextBlock Text="DISPOSITIVOS CON PROBLEMAS" Style="{StaticResource Label}" Margin="2,6,0,10"/>
                            <ItemsControl x:Name="DrvProblems">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border local:Motion.Stagger="True" Style="{StaticResource CardBorder}" Margin="0,0,0,8" Padding="18,12">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Left" Style="{StaticResource IconBox}" Width="36" Height="36" Background="#3A1518">
                                                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="15" Foreground="#F87171"/>
                                                </Border>
                                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Explanation}" Foreground="{StaticResource Sub}" FontSize="12" Margin="0,3,0,0"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Instalados -->
                        <DockPanel Margin="2,16,10,10">
                            <TextBlock x:Name="DrvListHint" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="DRIVERS DE FABRICANTES INSTALADOS" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ItemsControl x:Name="DrvList" Margin="0,0,10,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border local:Motion.Stagger="True" Style="{StaticResource CardBorder}" Margin="0,0,0,8" Padding="18,11">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Visibility="{Binding OldVisibility}" Tag="{Binding}" Click="DriverVendor_Click" Padding="12,6" FontSize="12"
                                                    Margin="16,0,0,0" VerticalAlignment="Center" ToolTip="Abre la página oficial de drivers del fabricante">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="11"/>
                                                    <TextBlock Text="Web del fabricante"/>
                                                </StackPanel>
                                            </Button>
                                            <StackPanel DockPanel.Dock="Right" Width="120" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DateText}" Foreground="{Binding DateBrush}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding AgeText}" Foreground="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                            <Border DockPanel.Dock="Left" Style="{StaticResource IconBox}" Width="36" Height="36">
                                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="15"/>
                                            </Border>
                                            <StackPanel Margin="12,0,10,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <Border Visibility="{Binding OldVisibility}" Background="#33260B" CornerRadius="6" Padding="7,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="Antiguo" Foreground="#FBBF24" FontSize="10.5" FontWeight="SemiBold"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding Provider, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding ClassLabel, Mode=OneWay}"/><Run Text="  ·  v"/><Run Text="{Binding Version, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Antes y después ===== -->
                <ScrollViewer x:Name="BeforeAfterPanel" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="32,0,26,14">
                    <StackPanel x:Name="BAStack">
                        <!-- Resumen -->
                        <Border CornerRadius="18" Padding="28,22" Margin="0,0,0,14" BorderThickness="1" BorderBrush="#352F66">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#251B4D" Offset="0"/>
                                    <GradientStop Color="#141A2E" Offset="0.55"/>
                                    <GradientStop Color="#0A2E3A" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Click="MeasureNow_Click" Padding="18,10" VerticalAlignment="Center" Margin="20,0,0,0"
                                        ToolTip="Guarda una medición del sistema para compararla con las anteriores">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Medir ahora"/>
                                    </StackPanel>
                                </Button>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="DESDE QUE USAS WINRAPTOR" FontSize="11" FontWeight="Bold" Foreground="#A5B4FC"/>
                                    <TextBlock x:Name="BASince" FontFamily="{StaticResource Display}" FontSize="22" FontWeight="Bold" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="BASummary" Foreground="#CBD5E1" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Tarjetas antes → ahora -->
                        <ItemsControl x:Name="BAKpis">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="4" VerticalAlignment="Top"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border local:Motion.Stagger="True" Style="{StaticResource CardBorder}" Margin="0,0,10,10" Padding="18,16">
                                        <StackPanel>
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" Visibility="{Binding DeltaVisibility}" Background="{Binding DeltaBg}" CornerRadius="7" Padding="7,2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Delta}" Foreground="{Binding DeltaFg}" FontSize="11" FontWeight="Bold"/>
                                                </Border>
                                                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" Foreground="#A78BFA" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                            <Grid Margin="0,14,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Bottom">
                                                    <TextBlock Text="ANTES" FontSize="9.5" FontWeight="Bold" Foreground="#4B5568"/>
                                                    <TextBlock Text="{Binding Before}" FontFamily="{StaticResource Display}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="&#xE72A;" FontFamily="{StaticResource Icons}" Foreground="#4B5568" FontSize="12" VerticalAlignment="Bottom" Margin="12,0,12,6"/>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                                    <TextBlock Text="AHORA" FontSize="9.5" FontWeight="Bold" Foreground="#A78BFA"/>
                                                    <TextBlock Text="{Binding After}" FontFamily="{StaticResource Display}" FontSize="24" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="{Binding Note}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Por categoría -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,10,10" Padding="20,16,20,10">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="16" Height="4" CornerRadius="2" Background="#4B5568" VerticalAlignment="Center"/>
                                        <TextBlock Text="Antes de WinRaptor" Foreground="{StaticResource Sub}" FontSize="11" Margin="6,0,14,0"/>
                                        <Border Width="16" Height="6" CornerRadius="3" Background="{StaticResource AccentGrad}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Ahora" Foreground="{StaticResource Sub}" FontSize="11" Margin="6,0,0,0"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="OPTIMIZACIONES ACTIVAS POR CATEGORÍA" Style="{StaticResource Label}"/>
                                        <TextBlock Text="Lo que ya traía Windows activado frente a lo que tienes hoy." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                                <local:CompareChart x:Name="BACompare"/>
                            </StackPanel>
                        </Border>

                        <!-- Arranque -->
                        <Border x:Name="BABootCard" Style="{StaticResource CardBorder}" Margin="0,0,10,10" Padding="20,16,20,12" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="TIEMPO DE ARRANQUE DE WINDOWS (SEGUNDOS)" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="BABootHint" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0"/>
                                <local:LineChart x:Name="BABoot" Height="190" Margin="0,10,0,0" Unit="s"/>
                            </StackPanel>
                        </Border>

                        <!-- Mediciones -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,10,10" Padding="20,16">
                            <StackPanel>
                                <TextBlock Text="MEDICIONES DEL SISTEMA" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="BAMeasureHint" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,2,0,12" TextWrapping="Wrap"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="BAColFirst" Grid.Column="1" Style="{StaticResource Label}" HorizontalAlignment="Right"/>
                                    <TextBlock x:Name="BAColLast" Grid.Column="2" Style="{StaticResource Label}" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="3" Text="CAMBIO" Style="{StaticResource Label}" HorizontalAlignment="Right"/>
                                </Grid>
                                <ItemsControl x:Name="BAMeasures">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border local:Motion.Stagger="True" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="150"/>
                                                        <ColumnDefinition Width="150"/>
                                                        <ColumnDefinition Width="110"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource Sub}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding First}" Foreground="{StaticResource Muted}" HorizontalAlignment="Right"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Last}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding Delta}" Foreground="{Binding DeltaFg}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Historial de cambios ===== -->
                <DockPanel x:Name="HistoryPanel" Grid.Row="2" Visibility="Collapsed" Margin="32,0,26,14">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,6,14">
                        <Button DockPanel.Dock="Left" Click="UndoLast_Click" Style="{StaticResource Primary}" Padding="16,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7A7;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Deshacer último cambio"/>
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="HistorySummary" Foreground="{StaticResource Sub}" VerticalAlignment="Center" Margin="16,0,0,0" TextWrapping="Wrap"/>
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                        <ItemsControl x:Name="HistoryList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid local:Motion.Stagger="True">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Línea de tiempo -->
                                        <Border Width="2" Background="{StaticResource LineStrong}" HorizontalAlignment="Center"/>
                                        <Ellipse Width="12" Height="12" VerticalAlignment="Top" Margin="0,22,0,0" Fill="{StaticResource AccentGrad}"/>
                                        <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="8,0,0,10" Padding="16,12">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Visibility="{Binding CurrentVisibility}" Background="#0F2E24" CornerRadius="8" Padding="10,3">
                                                        <TextBlock Text="● Estado actual" Foreground="#34D399" FontSize="12" FontWeight="SemiBold"/>
                                                    </Border>
                                                    <Button Visibility="{Binding RestoreVisibility}" Tag="{Binding}" Click="RestoreHistory_Click" Padding="14,6">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE7A7;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                            <TextBlock Text="Volver aquí"/>
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                                <Border DockPanel.Dock="Left" Style="{StaticResource IconBox}" Width="34" Height="34" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="14"/>
                                                </Border>
                                                <StackPanel Margin="12,0,12,0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding When}" Foreground="{StaticResource Muted}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Sub}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <!-- ===== Diagnóstico ===== -->
                <DockPanel x:Name="DiagPanel" Grid.Row="2" Visibility="Collapsed" Margin="32,0,26,14">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,6,14">
                        <Button DockPanel.Dock="Left" Click="RunDiag_Click" Style="{StaticResource Primary}" Padding="16,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Analizar el equipo"/>
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="DiagSummary" Foreground="{StaticResource Sub}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                        <ItemsControl x:Name="DiagList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border local:Motion.Stagger="True" Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Style="{StaticResource IconBox}" Background="{Binding IconBg}" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" Foreground="{Binding IconFg}"/>
                                            </Border>
                                            <StackPanel Margin="14,0,0,0">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"/>
                                                <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Sub}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                <TextBlock Text="{Binding Advice}" Visibility="{Binding AdviceVisibility}" Foreground="#C4B5FD"
                                                           TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <!-- ===== Programas de inicio ===== -->
                <DockPanel x:Name="StartupPanel" Grid.Row="2" Visibility="Collapsed" Margin="32,0,26,14">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,6,14">
                        <Button DockPanel.Dock="Left" Click="LoadStartup_Click" Padding="14,7">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Actualizar lista"/>
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="StartupSummary" Foreground="{StaticResource Sub}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                        <ItemsControl x:Name="StartupList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border local:Motion.Stagger="True" Style="{StaticResource CardBorder}" Margin="0,0,0,8" Padding="18,12">
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="{Binding Enabled}"
                                                      Click="StartupToggle_Click" Tag="{Binding}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                            <Border DockPanel.Dock="Left" Style="{StaticResource IconBox}" Width="34" Height="34"><TextBlock Text="&#xE7E8;" Style="{StaticResource Icon}" FontSize="14"/></Border>
                                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                    <Border Background="#1A1F2A" CornerRadius="6" Padding="7,1" Margin="10,0,0,0">
                                                        <TextBlock Text="{Binding Location}" Foreground="{StaticResource Sub}" FontSize="11"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Command}" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <!-- ===== Actualizar programas ===== -->
                <DockPanel x:Name="UpgradesPanel" Grid.Row="2" Visibility="Collapsed" Margin="32,0,26,14">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,6,14">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <Button Click="ScanUpgrades_Click" Padding="14,7">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Buscar actualizaciones"/>
                                </StackPanel>
                            </Button>
                            <Button Click="RunUpgrades_Click" Style="{StaticResource Primary}" Padding="16,7" Margin="10,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Actualizar seleccionados"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock x:Name="UpgradesSummary" Foreground="{StaticResource Sub}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                        <ItemsControl x:Name="UpgradesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border local:Motion.Stagger="True" Style="{StaticResource CardBorder}" Margin="0,0,0,8" Padding="18,12">
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                            <Border DockPanel.Dock="Left" Style="{StaticResource IconBox}" Width="34" Height="34" Background="#0C2733"><TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="14" Foreground="#67E8F9"/></Border>
                                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <TextBlock Text="{Binding Id}" Foreground="{StaticResource Muted}" FontSize="11"/>
                                                    <TextBlock Text="{Binding VersionText}" Foreground="#34D399" FontSize="11" Margin="14,0,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <!-- ===== Herramientas ===== -->
                <ScrollViewer x:Name="ToolsPanel" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="32,0,26,14">
                    <StackPanel>
                        <TextBlock Text="MANTENIMIENTO" Style="{StaticResource Label}" Margin="2,0,0,10"/>
                        <UniformGrid Columns="2" x:Name="ToolsGrid" VerticalAlignment="Top"/>
                        <TextBlock Text="ACCESOS RÁPIDOS" Style="{StaticResource Label}" Margin="2,14,0,10"/>
                        <UniformGrid Columns="4" x:Name="ShortcutsGrid" VerticalAlignment="Top"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Registro ===== -->
                <DockPanel x:Name="LogPanel" Grid.Row="2" Visibility="Collapsed" Margin="32,0,32,14">
                    <Button DockPanel.Dock="Top" HorizontalAlignment="Left" Click="OpenLog_Click" Padding="14,7" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8E5;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Abrir archivo de registro"/>
                        </StackPanel>
                    </Button>
                    <TextBox x:Name="LogBox" Style="{StaticResource Console}" IsReadOnly="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="12" AcceptsReturn="True"/>
                </DockPanel>

                <!-- ===== Carga al cambiar de sección ===== -->
                <Border x:Name="RouteBar" Grid.Row="2" VerticalAlignment="Top" Height="2" Margin="32,-10,32,0" CornerRadius="1" Opacity="0"
                        Background="{StaticResource AccentGrad}" RenderTransformOrigin="0,0.5" IsHitTestVisible="False" Panel.ZIndex="5">
                    <Border.RenderTransform><ScaleTransform x:Name="RouteScale" ScaleX="0"/></Border.RenderTransform>
                    <Border.Effect><DropShadowEffect Color="#8B5CF6" BlurRadius="10" ShadowDepth="0" Opacity="0.9"/></Border.Effect>
                </Border>
                <Grid x:Name="Skeleton" Grid.Row="2" Margin="32,0,32,14" Visibility="Collapsed" IsHitTestVisible="False" Panel.ZIndex="4" ClipToBounds="True">
                    <!-- Lista (secciones de ajustes, drivers, historial…) -->
                    <StackPanel x:Name="SkelList">
                        <UniformGrid Columns="2" Margin="0,0,0,16">
                            <Border Height="92" CornerRadius="16" Margin="0,0,12,0" Background="#12161F" BorderBrush="#1C2230" BorderThickness="1">
                                <DockPanel Margin="18,0">
                                    <Border DockPanel.Dock="Left" Width="50" Height="50" CornerRadius="14" Background="{StaticResource SkelBrush}"/>
                                    <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                                        <Border Width="150" Height="13" CornerRadius="6" Background="{StaticResource SkelBrush}" HorizontalAlignment="Left"/>
                                        <Border Width="230" Height="10" CornerRadius="5" Background="{StaticResource SkelBrush}" HorizontalAlignment="Left" Margin="0,9,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Height="92" CornerRadius="16" Background="#12161F" BorderBrush="#1C2230" BorderThickness="1">
                                <DockPanel Margin="18,0">
                                    <Border DockPanel.Dock="Left" Width="50" Height="50" CornerRadius="14" Background="{StaticResource SkelBrush}"/>
                                    <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                                        <Border Width="130" Height="13" CornerRadius="6" Background="{StaticResource SkelBrush}" HorizontalAlignment="Left"/>
                                        <Border Width="200" Height="10" CornerRadius="5" Background="{StaticResource SkelBrush}" HorizontalAlignment="Left" Margin="0,9,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </UniformGrid>
                        <DockPanel Margin="0,0,0,14">
                            <Border DockPanel.Dock="Right" Width="92" Height="30" CornerRadius="10" Background="{StaticResource SkelBrush}"/>
                            <Border DockPanel.Dock="Right" Width="104" Height="30" CornerRadius="10" Background="{StaticResource SkelBrush}" Margin="0,0,10,0"/>
                            <Border Width="140" Height="11" CornerRadius="5" Background="{StaticResource SkelBrush}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ItemsControl x:Name="SkelRows">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Height="78" CornerRadius="14" Margin="0,0,0,10" Background="#12161F" BorderBrush="#1C2230" BorderThickness="1">
                                        <DockPanel Margin="20,0">
                                            <Border DockPanel.Dock="Right" Width="46" Height="24" CornerRadius="12" Background="{StaticResource SkelBrush}"/>
                                            <Border DockPanel.Dock="Right" Width="86" Height="22" CornerRadius="8" Background="{StaticResource SkelBrush}" Margin="0,0,20,0"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="{Binding}" Height="13" CornerRadius="6" Background="{StaticResource SkelBrush}"/>
                                                    <Border Width="56" Height="16" CornerRadius="7" Background="{StaticResource SkelBrush}" Margin="10,0,0,0"/>
                                                </StackPanel>
                                                <Border Width="460" Height="10" CornerRadius="5" Background="{StaticResource SkelBrush}" HorizontalAlignment="Left" Margin="0,11,0,0"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <!-- Tarjetas (Inicio, Consejos, Modo juego…) -->
                    <StackPanel x:Name="SkelGrid" Visibility="Collapsed">
                        <Border Height="190" CornerRadius="18" Background="#12161F" BorderBrush="#1C2230" BorderThickness="1" Margin="0,0,0,16">
                            <DockPanel Margin="30,0">
                                <Border DockPanel.Dock="Left" Width="120" Height="120" CornerRadius="60" Background="{StaticResource SkelBrush}"/>
                                <Border DockPanel.Dock="Right" Width="170" Height="44" CornerRadius="12" Background="{StaticResource SkelBrush}"/>
                                <StackPanel VerticalAlignment="Center" Margin="28,0,20,0">
                                    <Border Width="120" Height="10" CornerRadius="5" Background="{StaticResource SkelBrush}" HorizontalAlignment="Left"/>
                                    <Border Width="340" Height="20" CornerRadius="8" Background="{StaticResource SkelBrush}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                                    <Border Width="420" Height="11" CornerRadius="5" Background="{StaticResource SkelBrush}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <UniformGrid Columns="4" Margin="0,0,0,16">
                            <Border Height="104" CornerRadius="14" Margin="0,0,10,0" Background="{StaticResource SkelBrush}"/>
                            <Border Height="104" CornerRadius="14" Margin="0,0,10,0" Background="{StaticResource SkelBrush}"/>
                            <Border Height="104" CornerRadius="14" Margin="0,0,10,0" Background="{StaticResource SkelBrush}"/>
                            <Border Height="104" CornerRadius="14" Background="{StaticResource SkelBrush}"/>
                        </UniformGrid>
                        <Border Width="200" Height="16" CornerRadius="7" Background="{StaticResource SkelBrush}" HorizontalAlignment="Left" Margin="2,4,0,12"/>
                        <UniformGrid Columns="2">
                            <Border Height="150" CornerRadius="14" Margin="0,0,10,0" Background="{StaticResource SkelBrush}"/>
                            <Border Height="150" CornerRadius="14" Background="{StaticResource SkelBrush}"/>
                        </UniformGrid>
                    </StackPanel>
                </Grid>

                <!-- ===== Barra de acciones ===== -->
                <Border x:Name="ActionBar" Grid.Row="3" Margin="32,4,32,18" Padding="20,14" CornerRadius="16" Background="#11151D"
                        BorderBrush="{StaticResource LineStrong}" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="4" Opacity="0.45"/>
                    </Border.Effect>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Click="UndoLast_Click" Margin="0,0,10,0" ToolTip="Vuelve al estado anterior al último cambio">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7A7;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Deshacer último"/>
                                </StackPanel>
                            </Button>
                            <Button Content="Deshacer seleccionados" Click="UndoSelected_Click"/>
                            <Button Style="{StaticResource Primary}" Click="Apply_Click" Margin="10,0,0,0" Padding="22,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Aplicar seleccionados"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <Border Style="{StaticResource IconBox}" DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="10">
                            <TextBlock x:Name="SelectionCount" Text="0" FontWeight="Bold" Foreground="#C4B5FD" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock x:Name="SelectionText" FontWeight="SemiBold" Text="Ningún ajuste seleccionado"/>
                            <CheckBox x:Name="RestorePointCheck" Style="{StaticResource Toggle}" IsChecked="True" Margin="0,6,0,0"
                                      RenderTransformOrigin="0,0.5">
                                <CheckBox.LayoutTransform><ScaleTransform ScaleX="0.8" ScaleY="0.8"/></CheckBox.LayoutTransform>
                                <TextBlock Text="Crear punto de restauración antes de aplicar" FontSize="15"/>
                            </CheckBox>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Notificación -->
        <Border x:Name="Toast" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,52,32,0" MaxWidth="440"
                CornerRadius="14" Background="#F21A1F2A" BorderBrush="#343C50" BorderThickness="1" Opacity="0" IsHitTestVisible="False">
            <Border.RenderTransform><TranslateTransform x:Name="ToastX"/></Border.RenderTransform>
            <Border.Effect><DropShadowEffect Color="Black" BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.55"/></Border.Effect>
            <Grid>
                <StackPanel Orientation="Horizontal" Margin="14,12,18,14">
                    <Border Width="30" Height="30" CornerRadius="9" VerticalAlignment="Top">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#3A2A7A" Offset="0"/>
                                <GradientStop Color="#0E3D4D" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="&#xE946;" FontFamily="{StaticResource Icons}" Foreground="#C4B5FD" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="ToastText" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="360" VerticalAlignment="Center" LineHeight="19"/>
                </StackPanel>
                <Border Height="2" VerticalAlignment="Bottom" Margin="14,0,14,1" CornerRadius="1" Background="{StaticResource AccentGrad}" RenderTransformOrigin="0,0.5">
                    <Border.RenderTransform><ScaleTransform x:Name="ToastBarScale"/></Border.RenderTransform>
                </Border>
            </Grid>
        </Border>

        <!-- Trabajo en curso -->
        <Grid x:Name="BusyOverlay" Background="#B307090D" Visibility="Collapsed">
            <Border x:Name="BusyCard" Style="{StaticResource CardBorder}" local:Motion.Hover="False" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="38,30,38,26" Width="460" CornerRadius="18">
                <Border.Effect><DropShadowEffect Color="Black" BlurRadius="40" ShadowDepth="12" Direction="270" Opacity="0.6"/></Border.Effect>
                <StackPanel>
                    <Grid Width="104" Height="104" HorizontalAlignment="Center" Margin="0,0,0,18">
                        <Ellipse Margin="-10">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#448B5CF6" Offset="0.4"/>
                                    <GradientStop Color="#008B5CF6" Offset="1"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Grid x:Name="BusySpinner">
                            <!-- Ondas de pulso -->
                            <Ellipse x:Name="Ripple1" Stroke="#8B5CF6" StrokeThickness="1.5" Opacity="0" RenderTransformOrigin="0.5,0.5" Margin="14">
                                <Ellipse.RenderTransform><ScaleTransform x:Name="Rip1S"/></Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse x:Name="Ripple2" Stroke="#22D3EE" StrokeThickness="1.5" Opacity="0" RenderTransformOrigin="0.5,0.5" Margin="14">
                                <Ellipse.RenderTransform><ScaleTransform x:Name="Rip2S"/></Ellipse.RenderTransform>
                            </Ellipse>
                            <!-- Pistas -->
                            <Ellipse Margin="8" Stroke="#1A2030" StrokeThickness="3"/>
                            <Ellipse Margin="19" Stroke="#161B28" StrokeThickness="2"/>
                            <!-- Cometas (se dibujan en código) -->
                            <Grid x:Name="CometOuter" Margin="8" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform><RotateTransform x:Name="RotOuter"/></Grid.RenderTransform>
                            </Grid>
                            <Grid x:Name="CometInner" Margin="19" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform><RotateTransform x:Name="RotInner"/></Grid.RenderTransform>
                            </Grid>
                            <!-- Raptor que respira -->
                            <Image x:Name="BusyMark" Source="pack://application:,,,/mark-bold.png" Width="44" Height="44" RenderOptions.BitmapScalingMode="HighQuality" RenderTransformOrigin="0.5,0.5">
                                <Image.RenderTransform><ScaleTransform x:Name="BreathS"/></Image.RenderTransform>
                                <Image.Effect><DropShadowEffect Color="#8B5CF6" BlurRadius="14" ShadowDepth="0" Opacity="0.6"/></Image.Effect>
                            </Image>
                        </Grid>
                        <Grid x:Name="BusyDone" Visibility="Collapsed">
                            <Ellipse x:Name="BusyDoneCircle" Fill="#0F2E24" Stroke="#34D399" StrokeThickness="2.5"/>
                            <TextBlock x:Name="BusyDoneGlyph" Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="28" Foreground="#34D399"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                    <TextBlock x:Name="BusyText" FontFamily="{StaticResource Display}" FontSize="18" FontWeight="Bold" Text="Trabajando…" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                    <TextBlock x:Name="BusyDetail" Foreground="{StaticResource Sub}" Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="384" HorizontalAlignment="Center" TextAlignment="Center" MinHeight="19"/>

                    <!-- Sin total conocido: barra indeterminada -->
                    <Grid x:Name="BusyIndeterminate" Height="4" Margin="0,20,0,0" ClipToBounds="True">
                        <Border CornerRadius="2" Background="#1C2230"/>
                        <Border Width="150" CornerRadius="2" HorizontalAlignment="Left" Background="{StaticResource AccentGrad}">
                            <Border.Effect><DropShadowEffect Color="#8B5CF6" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/></Border.Effect>
                            <Border.RenderTransform><TranslateTransform x:Name="Seg1X" X="-150"/></Border.RenderTransform>
                        </Border>
                        <Border Width="60" CornerRadius="2" HorizontalAlignment="Left" Background="{StaticResource AccentGrad}" Opacity="0.75">
                            <Border.RenderTransform><TranslateTransform x:Name="Seg2X" X="-60"/></Border.RenderTransform>
                        </Border>
                    </Grid>

                    <!-- Con total: progreso real, contador y lista de lo último hecho -->
                    <StackPanel x:Name="BusyProgressBox" Margin="0,20,0,0" Visibility="Collapsed">
                        <DockPanel>
                            <TextBlock x:Name="BusyPct" DockPanel.Dock="Right" FontWeight="Bold" Foreground="#C4B5FD" FontSize="13"/>
                            <TextBlock x:Name="BusyCount" Foreground="{StaticResource Sub}" FontSize="12" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Grid x:Name="BusyTrack" Height="6" Margin="0,8,0,0">
                            <Border CornerRadius="3" Background="#1C2230"/>
                            <Border x:Name="BusyFill" CornerRadius="3" Background="{StaticResource AccentGrad}" HorizontalAlignment="Left" Width="0">
                                <Border.Effect><DropShadowEffect Color="#8B5CF6" BlurRadius="10" ShadowDepth="0" Opacity="0.7"/></Border.Effect>
                            </Border>
                            <Border x:Name="BusySheenClip" HorizontalAlignment="Left" Width="{Binding ActualWidth, ElementName=BusyFill}" CornerRadius="3" ClipToBounds="True">
                                <Border Width="70" HorizontalAlignment="Left">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#00FFFFFF" Offset="0"/>
                                            <GradientStop Color="#77FFFFFF" Offset="0.5"/>
                                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.RenderTransform><TranslateTransform x:Name="SheenX" X="-70"/></Border.RenderTransform>
                                </Border>
                            </Border>
                        </Grid>
                        <ItemsControl x:Name="BusyLog" Margin="0,16,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel local:Motion.Stagger="True" Margin="0,3">
                                        <Border DockPanel.Dock="Left" Width="20" Height="20" CornerRadius="10" Background="{Binding Bg}" VerticalAlignment="Center">
                                            <Grid>
                                                <TextBlock Text="&#xE73E;" Visibility="{Binding OkVis}" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="#34D399" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Text="&#xE711;" Visibility="{Binding FailVis}" FontFamily="{StaticResource Icons}" FontSize="9" Foreground="#F87171" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <Border DockPanel.Dock="Right" Visibility="{Binding TagVis}" Background="{Binding TagBg}" CornerRadius="5" Padding="6,1" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Tag}" Foreground="{Binding TagFg}" FontSize="10" FontWeight="SemiBold"/>
                                        </Border>
                                        <TextBlock Text="{Binding Text}" Foreground="{StaticResource Sub}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="BusyElapsed" Foreground="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Vista previa de cambios -->
        <Grid x:Name="PreviewOverlay" Background="#B307090D" Visibility="Collapsed">
            <Border x:Name="PreviewCard" Style="{StaticResource CardBorder}" local:Motion.Hover="False" MaxWidth="900" Margin="48,28"
                    Padding="0" CornerRadius="18" VerticalAlignment="Stretch">
                <Border.Effect><DropShadowEffect Color="Black" BlurRadius="40" ShadowDepth="12" Direction="270" Opacity="0.6"/></Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Cabecera -->
                    <Border CornerRadius="18,18,0,0" Padding="28,22,28,18" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#221A45" Offset="0"/>
                                <GradientStop Color="#141A2A" Offset="0.6"/>
                                <GradientStop Color="#0C2633" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Chrome}" Content="&#xE8BB;" Click="PreviewCancel_Click" ToolTip="Cerrar sin cambiar nada" VerticalAlignment="Top" Margin="0,-8,-12,0"/>
                                <Border DockPanel.Dock="Left" Width="48" Height="48" CornerRadius="14" Background="{StaticResource AccentGrad}" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE7B3;" FontFamily="{StaticResource Icons}" FontSize="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="VISTA PREVIA DE CAMBIOS" FontSize="11" FontWeight="Bold" Foreground="#A5B4FC"/>
                                    <TextBlock x:Name="PreviewTitle" FontFamily="{StaticResource Display}" FontSize="22" FontWeight="Bold" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                            <TextBlock x:Name="PreviewSub" Foreground="#CBD5E1" Margin="0,12,0,0" TextWrapping="Wrap"/>
                            <WrapPanel Margin="0,12,0,0">
                                <Border Background="#1E1938" CornerRadius="8" Padding="10,4" Margin="0,0,8,6">
                                    <TextBlock x:Name="PvCount" Foreground="#C4B5FD" FontSize="12" FontWeight="SemiBold"/>
                                </Border>
                                <Border x:Name="PvRebootChip" Background="#1A1F2A" CornerRadius="8" Padding="10,4" Margin="0,0,8,6">
                                    <TextBlock x:Name="PvReboot" Foreground="#CBD5E1" FontSize="12" FontWeight="SemiBold"/>
                                </Border>
                                <Border x:Name="PvKernelChip" Background="#33260B" CornerRadius="8" Padding="10,4" Margin="0,0,8,6">
                                    <TextBlock x:Name="PvKernel" Foreground="#FBBF24" FontSize="12" FontWeight="SemiBold"/>
                                </Border>
                                <Border x:Name="PvActiveChip" Background="#0C2733" CornerRadius="8" Padding="10,4" Margin="0,0,8,6">
                                    <TextBlock x:Name="PvActive" Foreground="#67E8F9" FontSize="12" FontWeight="SemiBold"/>
                                </Border>
                                <Border Background="#0F2E24" CornerRadius="8" Padding="10,4" Margin="0,0,8,6">
                                    <TextBlock Text="✓ Todo se puede deshacer" Foreground="#34D399" FontSize="12" FontWeight="SemiBold"/>
                                </Border>
                            </WrapPanel>
                            <Border x:Name="PvBreaksBox" Background="#2A1F0C" BorderBrush="#6B5216" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,6,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource Icons}" Foreground="#FBBF24" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                    <TextBlock x:Name="PvBreaks" Foreground="#F5D28A" FontSize="12" TextWrapping="Wrap" Margin="10,0,0,0" MaxWidth="780"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Lista por secciones -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,14,20,6">
                        <ItemsControl x:Name="PreviewGroups">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4,8,6">
                                        <DockPanel Margin="2,6,0,8">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" Foreground="#A78BFA" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Display}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border local:Motion.Stagger="True" Margin="0,0,0,8" Padding="16,11" CornerRadius="12" Background="#12161F"
                                                            BorderBrush="#222836" BorderThickness="1" Opacity="{Binding ItemOpacity}">
                                                        <StackPanel>
                                                            <DockPanel>
                                                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="{Binding Include}" VerticalAlignment="Top" Margin="14,0,0,0"
                                                                          ToolTip="Incluir este cambio"/>
                                                                <StackPanel>
                                                                    <WrapPanel>
                                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                        <Border Background="{Binding RiskBg}" CornerRadius="6" Padding="7,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding RiskText}" Foreground="{Binding RiskFg}" FontSize="10.5" FontWeight="SemiBold"/>
                                                                        </Border>
                                                                        <Border Visibility="{Binding RestartVisibility}" Background="#1A1F2A" CornerRadius="6" Padding="7,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding RestartText}" Foreground="{StaticResource Sub}" FontSize="10.5"/>
                                                                        </Border>
                                                                        <Border Visibility="{Binding KernelVisibility}" Background="#33260B" CornerRadius="6" Padding="7,1" VerticalAlignment="Center">
                                                                            <TextBlock Text="Núcleo de Windows" Foreground="#FBBF24" FontSize="10.5" FontWeight="SemiBold"/>
                                                                        </Border>
                                                                    </WrapPanel>
                                                                    <TextBlock Text="{Binding Desc}" Foreground="{StaticResource Sub}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                                    <TextBlock Text="{Binding BreaksText}" Visibility="{Binding BreaksVisibility}" Foreground="#F5B754" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                                    <Button Style="{StaticResource Link}" Content="{Binding DetailsLabel}" Tag="{Binding}" Click="PreviewDetails_Click" HorizontalAlignment="Left" Margin="0,7,0,0"/>
                                                                </StackPanel>
                                                            </DockPanel>
                                                            <Border Visibility="{Binding DetailsVisibility}" Background="#0A0D13" CornerRadius="8" Padding="12,9" Margin="0,9,0,0"
                                                                    BorderBrush="#1C2230" BorderThickness="1">
                                                                <ItemsControl ItemsSource="{Binding Ops}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas" FontSize="11" Foreground="#A7B4C8" TextWrapping="Wrap" Margin="0,2"/>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Pie -->
                    <Border Grid.Row="2" Padding="28,14" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" CornerRadius="0,0,18,18" Background="#0F131B">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Cancelar" Click="PreviewCancel_Click" Padding="16,9"/>
                                <Button x:Name="PreviewMarkBtn" Click="PreviewMark_Click" Margin="10,0,0,0" Padding="16,9"
                                        ToolTip="Solo los marca en cada sección para que los revises; no cambia nada todavía">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE73A;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Solo marcar"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="PreviewApplyBtn" Style="{StaticResource Primary}" Click="PreviewApply_Click" Margin="10,0,0,0" Padding="20,9">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="PreviewApplyText" Text="Aplicar"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource Link}" Content="Incluir todos" Click="PreviewAll_Click"/>
                                <TextBlock Text="·" Foreground="{StaticResource Muted}" Margin="8,0"/>
                                <Button Style="{StaticResource Link}" Content="Quitar todos" Click="PreviewNone_Click"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Confirmación de cambio de frecuencia -->
        <Grid x:Name="HzOverlay" Background="#B307090D" Visibility="Collapsed">
            <Border x:Name="HzCard" Style="{StaticResource CardBorder}" local:Motion.Hover="False" Width="460" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="30,26" CornerRadius="18">
                <Border.Effect><DropShadowEffect Color="Black" BlurRadius="40" ShadowDepth="12" Direction="270" Opacity="0.6"/></Border.Effect>
                <StackPanel>
                    <Border Width="52" Height="52" CornerRadius="15" Background="{StaticResource AccentGrad}" HorizontalAlignment="Left">
                        <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource Icons}" FontSize="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="HzTitle" FontFamily="{StaticResource Display}" FontSize="21" FontWeight="Bold" Margin="0,16,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="HzText" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="20"/>
                    <Grid Height="4" Margin="0,18,0,0">
                        <Border CornerRadius="2" Background="#1C2230"/>
                        <Border x:Name="HzBar" CornerRadius="2" Background="{StaticResource AccentGrad}" HorizontalAlignment="Left" Width="400"/>
                    </Grid>
                    <DockPanel Margin="0,20,0,0" LastChildFill="False">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Click="HzKeep_Click" Padding="20,10" Content="Mantener"/>
                        <Button DockPanel.Dock="Right" Click="HzRevert_Click" Padding="18,10" Margin="0,0,10,0" Content="Volver atrás"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Aviso de reinicio necesario -->
        <Grid x:Name="RebootOverlay" Background="#B307090D" Visibility="Collapsed">
            <Border x:Name="RebootCard" Style="{StaticResource CardBorder}" local:Motion.Hover="False" Width="520" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="32,28" CornerRadius="18" BorderBrush="#6B5216">
                <Border.Effect><DropShadowEffect Color="Black" BlurRadius="40" ShadowDepth="12" Direction="270" Opacity="0.6"/></Border.Effect>
                <StackPanel>
                    <DockPanel>
                        <Grid Width="56" Height="56" DockPanel.Dock="Left">
                            <Ellipse Margin="-12">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#55FBBF24" Offset="0.3"/>
                                        <GradientStop Color="#00FBBF24" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Border CornerRadius="16" Background="#33260B" BorderBrush="#6B5216" BorderThickness="1">
                                <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource Icons}" FontSize="24" Foreground="#FBBF24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="REINICIO NECESARIO" FontSize="11" FontWeight="Bold" Foreground="#FBBF24"/>
                            <TextBlock x:Name="RebootTitle" FontFamily="{StaticResource Display}" FontSize="21" FontWeight="Bold" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock x:Name="RebootText" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,16,0,0" LineHeight="20"/>
                    <Border Background="#0E1118" CornerRadius="12" Padding="14,10" Margin="0,16,0,0" BorderBrush="{StaticResource Line}" BorderThickness="1">
                        <StackPanel>
                            <ItemsControl x:Name="RebootList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,4">
                                            <Border DockPanel.Dock="Right" Background="{Binding Bg}" CornerRadius="5" Padding="7,1" VerticalAlignment="Center" Margin="10,0,0,0">
                                                <TextBlock Text="{Binding Kind}" Foreground="{Binding Fg}" FontSize="10" FontWeight="Bold"/>
                                            </Border>
                                            <Ellipse DockPanel.Dock="Left" Width="6" Height="6" Fill="{Binding Fg}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Text}" Margin="10,0,0,0" FontSize="12.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="RebootMore" Foreground="{StaticResource Muted}" FontSize="11" Margin="16,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <DockPanel Margin="0,22,0,0" LastChildFill="False">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Click="RebootNow_Click" Padding="18,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Reiniciar ahora"/>
                            </StackPanel>
                        </Button>
                        <Button DockPanel.Dock="Right" Click="RebootLater_Click" Content="Más tarde" Margin="0,0,10,0" Padding="18,10"/>
                    </DockPanel>
                    <TextBlock Text="Guarda lo que tengas abierto: al pulsar «Reiniciar ahora» Windows se reinicia en 10 segundos." Foreground="{StaticResource Muted}"
                               FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap" HorizontalAlignment="Right" TextAlignment="Right"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Pantalla de carga -->
        <Grid x:Name="Splash" Background="{StaticResource Bg}">
            <Ellipse Width="760" Height="560" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-280,-220,0" IsHitTestVisible="False" Opacity="0.25">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#7C3AED" Offset="0"/>
                        <GradientStop Color="#007C3AED" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="700" Height="500" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-200,0,0,-280" IsHitTestVisible="False" Opacity="0.16">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#06B6D4" Offset="0"/>
                        <GradientStop Color="#0006B6D4" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid x:Name="SplashLogo" Width="210" Height="210" HorizontalAlignment="Center" Opacity="0">
                    <Ellipse x:Name="SplashGlow" Margin="-50" IsHitTestVisible="False">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#667C3AED" Offset="0.35"/>
                                <GradientStop Color="#007C3AED" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Image x:Name="SplashMark" Source="pack://application:,,,/mark.png" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Image x:Name="SplashScan" Source="pack://application:,,,/mark.png" RenderOptions.BitmapScalingMode="HighQuality" Opacity="0">
                        <Image.Effect><DropShadowEffect Color="White" BlurRadius="16" ShadowDepth="0" Opacity="0.85"/></Image.Effect>
                    </Image>
                </Grid>
                <TextBlock x:Name="SplashTitle" Text="WinRaptor" FontFamily="{StaticResource Display}" FontSize="32" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,6,0,0" Opacity="0"/>
                <TextBlock x:Name="SplashSub" Text="O P T I M I Z E R" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,4,0,0" Opacity="0"/>
                <StackPanel x:Name="SplashProgress" Opacity="0">
                    <Grid Width="260" Height="4" Margin="0,34,0,0">
                        <Border CornerRadius="2" Background="#1C2230"/>
                        <Border x:Name="SplashBar" CornerRadius="2" Background="{StaticResource AccentGrad}" HorizontalAlignment="Left" Width="0">
                            <Border.Effect><DropShadowEffect Color="#8B5CF6" BlurRadius="10" ShadowDepth="0" Opacity="0.8"/></Border.Effect>
                        </Border>
                    </Grid>
                    <TextBlock x:Name="SplashStatus" Text="Iniciando…" Foreground="{StaticResource Sub}" FontSize="12" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
